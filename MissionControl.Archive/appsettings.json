{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "mission-control",
    "VirtualHost": "/mission-control",
    "ClientProvidedName": "mission-control-archive-development"
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "ClientName": "mission-control-archive-development",
    "StreamName": "MISSION_CONTROL_EVENTS"
  },
  "NatsConsumer": {
    "DurableName": "mission-control-archive",
    "FilterSubject": "events.>",
    "MaxDeliveries": 2
  },
  "RabbitMqConsumer": {
    "ExchangeName": "kgivler.events",
    "QueueName": "mission-control.archive",
    "RoutingKey": "#",
    "PrefetchCount": 10
  },
  "EventArchive": {
    "DatabaseFileName": "mission-control.db"
  },
  "AllowedHosts": "*"
}

@if (IsLoading)
{
    <div class="resource-grid" aria-label="Loading node resource usage">
        @for (int index = 0; index < 2; index++)
        {
            <div class="resource-card resource-card-loading">
                <span></span>
                <strong></strong>
                <div></div>
            </div>
        }
    </div>
}
else if (Host is not null)
{
    <div class="resource-grid">
        @if (HasMemoryMetrics)
        {
            <article class="resource-card">
                <div class="resource-card-heading">
                    <h3>Memory</h3>
                    <strong>@($"{MemoryPercent:0.#}%")</strong>
                </div>

                <div class="resource-progress"
                     role="progressbar"
                     aria-label="Host memory usage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@($"{MemoryPercent:0.#}")">
                    <div class="resource-progress-value"
                         style="@GetProgressStyle(MemoryPercent)">
                    </div>
                </div>

                <div class="resource-card-meta">
                    <span>
                        @FormatBytes(MemoryUsedBytes) of
                        @FormatBytes(Host.MemoryTotalBytes!.Value) used
                    </span>
                    <span>
                        @FormatBytes(Host.MemoryAvailableBytes!.Value) available
                    </span>
                </div>
            </article>
        }

        @if (Host.CpuPercent is not null)
        {
            <article class="resource-card">
                <div class="resource-card-heading">
                    <h3>CPU</h3>
                    <strong>@($"{Host.CpuPercent:0.#}%")</strong>
                </div>

                <div class="resource-progress"
                     role="progressbar"
                     aria-label="Host CPU usage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@($"{Host.CpuPercent:0.#}")">
                    <div class="resource-progress-value"
                         style="@GetProgressStyle(Host.CpuPercent.Value)">
                    </div>
                </div>

                <div class="resource-card-meta resource-card-meta-end">
                    <span>
                        @Host.LogicalProcessorCount
                        @(Host.LogicalProcessorCount == 1
                            ? "logical CPU"
                            : "logical CPUs")
                    </span>
                </div>
            </article>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-warning resource-alert">
        @ErrorMessage
    </div>
}

@code {
    [Parameter]
    public HostMetricItem? Host { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private bool HasMemoryMetrics =>
        Host?.MemoryTotalBytes is > 0 &&
        Host.MemoryAvailableBytes is >= 0;

    private long MemoryUsedBytes =>
        Host?.MemoryTotalBytes is not null &&
        Host.MemoryAvailableBytes is not null
            ? Math.Max(
                0,
                Host.MemoryTotalBytes.Value -
                Host.MemoryAvailableBytes.Value)
            : 0;

    private double MemoryPercent =>
        Host?.MemoryTotalBytes is > 0
            ? (double)MemoryUsedBytes /
              Host.MemoryTotalBytes.Value * 100.0
            : 0;

    private static string GetProgressStyle(double percentage)
    {
        double width = Math.Clamp(percentage, 0, 100);
        return $"width: {width:0.##}%";
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = Math.Max(0, bytes);
        int unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.##} {units[unitIndex]}";
    }
}

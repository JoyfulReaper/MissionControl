@page "/events"
@implements IAsyncDisposable

@inject IArchiveEventClient ArchiveClient
@inject IDashboardDateTimeFormatter DateTimeFormatter
@inject IOptions<DashboardRefreshOptions> RefreshOptions
@inject IDashboardPollingLoop PollingLoop

<PageTitle>Events</PageTitle>

<header class="page-header">
    <div class="page-eyebrow">
        Event archive
    </div>

    <h1>Events</h1>

    <p class="page-description">
        Filter recent integration activity and open any event for its
        complete metadata and payload.
    </p>
</header>

<section class="filter-panel"
         aria-labelledby="event-filters-title">
    <div class="filter-heading">
        <div>
            <h2 id="event-filters-title">Filter events</h2>
            <p>Use the first row to match; the second row hides.</p>
        </div>

        @if (HasActiveFilters)
        {
            <span class="active-filter-indicator">
                Filters active
            </span>
        }
    </div>

    <div class="filter-grid">
        <div>
            <label for="source-filter"
                   class="form-label">
                Source
            </label>

            <input id="source-filter"
                   class="form-control"
                   list="source-options"
                   placeholder="Type or select a source"
                   autocomplete="off"
                   @bind="_sourceFilter"
                   @bind:event="oninput"
                   @onkeydown="HandleFilterKeyDown" />

            <datalist id="source-options">
                @foreach (string source in _sourceSuggestions)
                {
                    <option value="@source"></option>
                }
            </datalist>
        </div>

        <div>
            <label for="event-type-filter"
                   class="form-label">
                Event type
            </label>

            <input id="event-type-filter"
                   class="form-control"
                   list="event-type-options"
                   placeholder="Type or select an event type"
                   autocomplete="off"
                   @bind="_eventTypeFilter"
                   @bind:event="oninput"
                   @onkeydown="HandleFilterKeyDown" />

            <datalist id="event-type-options">
                @foreach (string eventType in _eventTypeSuggestions)
                {
                    <option value="@eventType"></option>
                }
            </datalist>
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@IsBusy"
                    @onclick="ApplyFiltersAsync">
                @(_isLoading ? "Loading..." : "Apply")
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(IsBusy || !HasActiveFilters)"
                    @onclick="ClearFiltersAsync">
                Clear
            </button>
        </div>
    </div>

    <div class="exclusion-grid">
        <div>
            <label for="source-exclusion"
                   class="form-label">
                Exclude source
            </label>

            <div class="exclusion-control">
                <input id="source-exclusion"
                       class="form-control"
                       list="source-options"
                       placeholder="Hide a source"
                       autocomplete="off"
                       @bind="_sourceExclusion"
                       @bind:event="oninput"
                       @onkeydown="HandleSourceExclusionKeyDown" />

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@(IsBusy || string.IsNullOrWhiteSpace(_sourceExclusion))"
                        @onclick="ExcludeSource">
                    Hide
                </button>
            </div>
        </div>

        <div>
            <label for="event-type-exclusion"
                   class="form-label">
                Exclude event type
            </label>

            <div class="exclusion-control">
                <input id="event-type-exclusion"
                       class="form-control"
                       list="event-type-options"
                       placeholder="Hide an event type"
                       autocomplete="off"
                       @bind="_eventTypeExclusion"
                       @bind:event="oninput"
                       @onkeydown="HandleEventTypeExclusionKeyDown" />

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@(IsBusy || string.IsNullOrWhiteSpace(_eventTypeExclusion))"
                        @onclick="ExcludeEventTypeFromInput">
                    Hide
                </button>
            </div>
        </div>
    </div>

    @if (HasExclusions)
    {
        <div class="exclusion-summary">
            @if (_excludedSources.Count > 0)
            {
                <div class="exclusion-group">
                    <span class="exclusion-label">Hidden sources</span>

                    <div class="exclusion-chips">
                        @foreach (string source in
                            _excludedSources.OrderBy(
                                value => value,
                                StringComparer.OrdinalIgnoreCase))
                        {
                            <button type="button"
                                    class="exclusion-chip"
                                    title="Show @source again"
                                    @onclick="() => IncludeSource(source)">
                                @source
                                <span aria-hidden="true">×</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_excludedEventTypes.Count > 0)
            {
                <div class="exclusion-group">
                    <span class="exclusion-label">Hidden event types</span>

                    <div class="exclusion-chips">
                        @foreach (string eventType in
                            _excludedEventTypes.OrderBy(
                                value => value,
                                StringComparer.OrdinalIgnoreCase))
                        {
                            <button type="button"
                                    class="exclusion-chip"
                                    title="Show @eventType again"
                                    @onclick="() => IncludeEventType(eventType)">
                                @eventType
                                <span aria-hidden="true">×</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(_refreshWarning))
{
    <div class="alert alert-warning">
        @_refreshWarning
    </div>
}

@if (_newEventsAvailable)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>New events are available.</span>
        <button type="button"
                class="btn btn-sm btn-outline-primary"
                disabled="@IsBusy"
                @onclick="LoadNewestAsync">
            Load newest
        </button>
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">
        @_error
    </div>
}
else if (_isLoading)
{
    <div class="event-list event-list-loading"
         aria-label="Loading Mission Control events">
        @for (int index = 0; index < 5; index++)
        {
            <div class="event-card event-card-loading">
                <span></span>
                <span></span>
                <span></span>
            </div>
        }
    </div>
}
else if (_visibleEvents.Count == 0)
{
    <div class="empty-state">
        @if (_events.Count == 0)
        {
            <h2>No events found</h2>
            <p>
                No archived events match the current filters.
            </p>
        }
        else
        {
            <h2>No visible events</h2>
            <p>
                All loaded events are hidden by the current exclusions.
            </p>
        }

        @if (HasActiveFilters)
        {
            <button type="button"
                    class="btn btn-outline-primary"
                    @onclick="ClearFiltersAsync">
                Clear filters
            </button>
        }

        @if (_events.Count > 0 && _hasMore)
        {
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsBusy"
                    @onclick="LoadOlderAsync">
                @(_isLoadingMore
                    ? "Loading older events..."
                    : "Load older")
            </button>
        }
    </div>
}
else
{
    <div class="event-results-heading">
        <div>
            <h2>Recent events</h2>
            <span>
                @LoadedEventCountLabel
            </span>
        </div>

        <span>Newest first</span>
    </div>

    <div class="event-list-header" aria-hidden="true">
        <span>Occurred</span>
        <span>Source</span>
        <span>Event type</span>
        <span>Correlation</span>
        <span></span>
    </div>

    <div class="event-list">
        @foreach (ArchiveEventSummaryItem item in _visibleEvents)
        {
            <article class="event-card"
                     role="button"
                     tabindex="0"
                     aria-label="Open @item.EventType event from @item.Source"
                     @onclick="() => OpenEventModal(item.EventId)"
                     @onkeydown="eventArgs =>
                        HandleEventRowKeyDown(eventArgs, item.EventId)">
                <div class="event-field event-occurred"
                     data-label="Occurred">
                    <time datetime="@item.OccurredAt.ToString("O")"
                          title="@DateTimeFormatter.Format(item.OccurredAt)">
                        @DateTimeFormatter.FormatRelative(item.OccurredAt)
                    </time>
                </div>

                <div class="event-field"
                     data-label="Source">
                    <span class="event-source">@item.Source</span>
                </div>

                <div class="event-field event-type"
                     data-label="Event type"
                     title="@item.EventType">
                    @item.EventType
                </div>

                <div class="event-field event-correlation"
                     data-label="Correlation">
                    <code title="@item.CorrelationId">
                        @(item.CorrelationId ?? "—")
                    </code>
                </div>

                <div class="event-action">
                    <button type="button"
                            class="event-hide-action"
                            title="Hide all @item.EventType events"
                            aria-label="Hide all @item.EventType events"
                            @onclick="() => ExcludeEventType(item.EventType)"
                            @onclick:stopPropagation="true"
                            @onkeydown:stopPropagation="true">
                        Hide type
                    </button>

                    <a href="@($"events/{item.EventId:D}")"
                       aria-label="Open @item.EventType on its own page"
                       @onclick:stopPropagation="true"
                       @onkeydown:stopPropagation="true">
                        Full page
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        }
    </div>

    @if (_loadMoreError is not null)
    {
        <div class="alert alert-danger">
            @_loadMoreError
        </div>
    }

    @if (_hasMore)
    {
        <div class="load-more">
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@IsBusy"
                    @onclick="LoadOlderAsync">
                @(_isLoadingMore
                    ? "Loading older events..."
                    : "Load older")
            </button>
        </div>
    }
}

@if (_selectedEventId is Guid selectedEventId)
{
    <EventDetailsModal EventId="selectedEventId"
                       OnClosed="CloseEventModal" />
}

@code {
    private EventFeedController _feed = null!;
    private readonly CancellationTokenSource _disposeSource = new();
    private Task? _pollingTask;
    private bool _disposed;
    private string? _sourceExclusion;
    private string? _eventTypeExclusion;
    private readonly HashSet<string> _excludedSources =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _excludedEventTypes =
        new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<ArchiveEventSummaryItem> _events => _feed.Events;
    private IReadOnlyList<ArchiveEventSummaryItem> _visibleEvents =>
        _events
            .Where(item =>
                !_excludedSources.Contains(item.Source) &&
                !_excludedEventTypes.Contains(item.EventType))
            .ToArray();
    private IReadOnlyList<string> _sourceSuggestions =>
        _feed.SourceSuggestions;
    private IReadOnlyList<string> _eventTypeSuggestions =>
        _feed.EventTypeSuggestions;
    private string? _sourceFilter
    {
        get => _feed.SourceFilter;
        set => _feed.SourceFilter = value;
    }
    private string? _eventTypeFilter
    {
        get => _feed.EventTypeFilter;
        set => _feed.EventTypeFilter = value;
    }
    private Guid? _selectedEventId => _feed.SelectedEventId;
    private bool _isLoading => _feed.IsInitialLoading;
    private bool _isLoadingMore => _feed.IsLoadingMore;
    private bool _hasMore => _feed.HasMore;
    private bool _newEventsAvailable => _feed.NewEventsAvailable;
    private string? _error => _feed.Error;
    private string? _refreshWarning => _feed.RefreshWarning;
    private string? _loadMoreError => _feed.LoadMoreError;
    private bool IsBusy => _feed.IsRefreshing;
    private bool HasExclusions =>
        _excludedSources.Count > 0 ||
        _excludedEventTypes.Count > 0;
    private bool HasActiveFilters =>
        _feed.HasActiveFilters || HasExclusions;
    private string LoadedEventCountLabel =>
        HasExclusions
            ? $"{_visibleEvents.Count:N0} visible · {_events.Count:N0} loaded"
            : $"{_events.Count:N0} loaded";

    protected override async Task OnInitializedAsync()
    {
        _feed = new EventFeedController(ArchiveClient);
        await _feed.LoadInitialAsync(_disposeSource.Token);

        _pollingTask = PollingLoop.RunAsync(
            TimeSpan.FromSeconds(
                RefreshOptions.Value.EventRefreshSeconds),
            PollEventsAsync,
            _disposeSource.Token);
    }

    private async Task PollEventsAsync(
        CancellationToken cancellationToken)
    {
        await _feed.PollAsync(cancellationToken);

        if (!_disposed && !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ApplyFiltersAsync()
    {
        return _feed.ApplyFiltersAsync(_disposeSource.Token);
    }

    private async Task ClearFiltersAsync()
    {
        _sourceExclusion = null;
        _eventTypeExclusion = null;
        _excludedSources.Clear();
        _excludedEventTypes.Clear();

        await _feed.ClearFiltersAsync(_disposeSource.Token);
    }

    private void ExcludeSource()
    {
        string? source = NormalizeExclusion(_sourceExclusion);

        if (source is null)
        {
            return;
        }

        _excludedSources.Add(source);
        _sourceExclusion = null;
    }

    private void ExcludeEventTypeFromInput()
    {
        string? eventType = NormalizeExclusion(_eventTypeExclusion);

        if (eventType is null)
        {
            return;
        }

        ExcludeEventType(eventType);
        _eventTypeExclusion = null;
    }

    private void ExcludeEventType(string eventType)
    {
        string? normalized = NormalizeExclusion(eventType);

        if (normalized is not null)
        {
            _excludedEventTypes.Add(normalized);
        }
    }

    private void IncludeSource(string source)
    {
        _excludedSources.Remove(source);
    }

    private void IncludeEventType(string eventType)
    {
        _excludedEventTypes.Remove(eventType);
    }

    private Task LoadOlderAsync()
    {
        return _feed.LoadOlderAsync(_disposeSource.Token);
    }

    private Task LoadNewestAsync()
    {
        return _feed.LoadNewestAsync(_disposeSource.Token);
    }

    private void OpenEventModal(Guid eventId)
    {
        _feed.SelectEvent(eventId);
    }

    private void CloseEventModal()
    {
        _feed.CloseSelectedEvent();
    }

    private void HandleEventRowKeyDown(
        KeyboardEventArgs eventArgs,
        Guid eventId)
    {
        if (eventArgs.Key is "Enter" or " ")
        {
            OpenEventModal(eventId);
        }
    }

    private Task HandleFilterKeyDown(
        KeyboardEventArgs eventArgs)
    {
        return eventArgs.Key == "Enter" && !IsBusy
            ? ApplyFiltersAsync()
            : Task.CompletedTask;
    }

    private void HandleSourceExclusionKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !IsBusy)
        {
            ExcludeSource();
        }
    }

    private void HandleEventTypeExclusionKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !IsBusy)
        {
            ExcludeEventTypeFromInput();
        }
    }

    private static string? NormalizeExclusion(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _disposeSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}

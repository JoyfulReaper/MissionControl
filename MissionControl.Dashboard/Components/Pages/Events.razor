@page "/events"

@inject IArchiveEventClient ArchiveClient
@inject IDashboardDateTimeFormatter DateTimeFormatter

<PageTitle>Events</PageTitle>

<header class="page-header">
    <div class="page-eyebrow">
        Event archive
    </div>

    <h1>Events</h1>

    <p class="page-description">
        Filter recent integration activity and open any event for its
        complete metadata and payload.
    </p>
</header>

<section class="filter-panel"
         aria-labelledby="event-filters-title">
    <div class="filter-heading">
        <div>
            <h2 id="event-filters-title">Filter events</h2>
            <p>Press Enter in either field to apply.</p>
        </div>

        @if (HasActiveFilters)
        {
            <span class="active-filter-indicator">
                Filters active
            </span>
        }
    </div>

    <div class="filter-grid">
        <div>
            <label for="source-filter"
                   class="form-label">
                Source
            </label>

            <input id="source-filter"
                   class="form-control"
                   list="source-options"
                   placeholder="Type or select a source"
                   autocomplete="off"
                   @bind="_sourceFilter"
                   @bind:event="oninput"
                   @onkeydown="HandleFilterKeyDown" />

            <datalist id="source-options">
                @foreach (string source in _sourceSuggestions)
                {
                    <option value="@source"></option>
                }
            </datalist>
        </div>

        <div>
            <label for="event-type-filter"
                   class="form-label">
                Event type
            </label>

            <input id="event-type-filter"
                   class="form-control"
                   list="event-type-options"
                   placeholder="Type or select an event type"
                   autocomplete="off"
                   @bind="_eventTypeFilter"
                   @bind:event="oninput"
                   @onkeydown="HandleFilterKeyDown" />

            <datalist id="event-type-options">
                @foreach (string eventType in _eventTypeSuggestions)
                {
                    <option value="@eventType"></option>
                }
            </datalist>
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@IsBusy"
                    @onclick="ApplyFiltersAsync">
                @(_isLoading ? "Loading..." : "Apply")
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(IsBusy || !HasActiveFilters)"
                    @onclick="ClearFiltersAsync">
                Clear
            </button>
        </div>
    </div>
</section>

@if (_error is not null)
{
    <div class="alert alert-danger">
        @_error
    </div>
}
else if (_isLoading)
{
    <div class="event-list event-list-loading"
         aria-label="Loading Mission Control events">
        @for (int index = 0; index < 5; index++)
        {
            <div class="event-card event-card-loading">
                <span></span>
                <span></span>
                <span></span>
            </div>
        }
    </div>
}
else if (_events.Count == 0)
{
    <div class="empty-state">
        <h2>No events found</h2>
        <p>
            No archived events match the current filters.
        </p>

        @if (HasActiveFilters)
        {
            <button type="button"
                    class="btn btn-outline-primary"
                    @onclick="ClearFiltersAsync">
                Clear filters
            </button>
        }
    </div>
}
else
{
    <div class="event-results-heading">
        <div>
            <h2>Recent events</h2>
            <span>
                @(_events.Count.ToString("N0")) loaded
            </span>
        </div>

        <span>Newest first</span>
    </div>

    <div class="event-list-header" aria-hidden="true">
        <span>Occurred</span>
        <span>Source</span>
        <span>Event type</span>
        <span>Correlation</span>
        <span></span>
    </div>

    <div class="event-list">
        @foreach (var item in _events)
        {
            <article class="event-card"
                     role="button"
                     tabindex="0"
                     aria-label="Open @item.EventType event from @item.Source"
                     @onclick="() => OpenEventModal(item.EventId)"
                     @onkeydown="eventArgs =>
                        HandleEventRowKeyDown(eventArgs, item.EventId)">
                <div class="event-field event-occurred"
                     data-label="Occurred">
                    <time datetime="@item.OccurredAt.ToString("O")">
                        @DateTimeFormatter.Format(item.OccurredAt)
                    </time>
                </div>

                <div class="event-field"
                     data-label="Source">
                    <span class="event-source">@item.Source</span>
                </div>

                <div class="event-field event-type"
                     data-label="Event type"
                     title="@item.EventType">
                    @item.EventType
                </div>

                <div class="event-field event-correlation"
                     data-label="Correlation">
                    <code title="@item.CorrelationId">
                        @(item.CorrelationId ?? "—")
                    </code>
                </div>

                <div class="event-action">
                    <a href="@($"events/{item.EventId:D}")"
                       aria-label="Open @item.EventType on its own page"
                       @onclick:stopPropagation="true"
                       @onkeydown:stopPropagation="true">
                        Full page
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        }
    </div>
    @if (_loadMoreError is not null)
    {
        <div class="alert alert-danger">
            @_loadMoreError
        </div>
    }

    @if (_hasMore)
    {
        <div class="load-more">
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@IsBusy"
                    @onclick="LoadOlderAsync">
                @(_isLoadingMore
                    ? "Loading older events..."
                    : "Load older")
            </button>
        </div>
    }
}

@if (_selectedEventId is Guid selectedEventId)
{
    <EventDetailsModal EventId="selectedEventId"
                       OnClosed="CloseEventModal" />
}

@code {
    private IReadOnlyList<ArchiveEventSummaryItem> _events = [];

    private IReadOnlyList<string> _sourceSuggestions = [];
    private IReadOnlyList<string> _eventTypeSuggestions = [];

    private string? _sourceFilter;
    private string? _eventTypeFilter;
    private Guid? _selectedEventId;

    private const int PageSize = 50;

    private bool _isLoading;
    private bool _isLoadingMore;
    private bool _hasMore;
    private string? _error;
    private string? _loadMoreError;

    private bool IsBusy =>
        _isLoading || _isLoadingMore;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_sourceFilter) ||
        !string.IsNullOrWhiteSpace(_eventTypeFilter);


    protected override Task OnInitializedAsync()
    {
        return LoadEventsAsync(
            refreshSuggestions: true,
            ignoreFilters: true);
    }

    private void UpdateSuggestions(
        IEnumerable<ArchiveEventSummaryItem> events)
    {
        _sourceSuggestions = events
            .Select(item => item.Source)
            .Where(source => !string.IsNullOrWhiteSpace(source))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(source => source, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        _eventTypeSuggestions = events
            .Select(item => item.EventType)
            .Where(eventType => !string.IsNullOrWhiteSpace(eventType))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(eventType => eventType, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string? NormalizeFilter(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private async Task LoadEventsAsync(
        bool refreshSuggestions = false,
        bool ignoreFilters = false,
        bool append = false)
    {
        if (IsBusy)
        {
            return;
        }

        if (append)
        {
            _isLoadingMore = true;
            _loadMoreError = null;
        }
        else
        {
            _isLoading = true;
            _error = null;
            _loadMoreError = null;
        }

        try
        {
            string? source = ignoreFilters
                ? null
                : NormalizeFilter(_sourceFilter);

            string? eventType = ignoreFilters
                ? null
                : NormalizeFilter(_eventTypeFilter);

            ArchiveEventCursor? cursor =
                append && _events.Count > 0
                    ? CreateCursor(_events[^1])
                    : null;

            IReadOnlyList<ArchiveEventSummaryItem> result =
                await ArchiveClient.GetRecentAsync(
                    limit: PageSize + 1,
                    source: source,
                    eventType: eventType,
                    before: cursor);

            ArchiveEventSummaryItem[] page = result
                .Take(PageSize)
                .ToArray();

            _hasMore = result.Count > PageSize;

            _events = append
                ? _events.Concat(page).ToArray()
                : page;

            if (refreshSuggestions)
            {
                UpdateSuggestions(_events);
            }
        }
        catch (HttpRequestException exception)
        {
            SetError(
                append,
                $"Mission Control Archive could not be reached: " +
                exception.Message);
        }
        catch (TaskCanceledException)
        {
            SetError(
                append,
                "The Mission Control Archive request timed out.");
        }
        finally
        {
            if (append)
            {
                _isLoadingMore = false;
            }
            else
            {
                _isLoading = false;
            }
        }
    }

    private static ArchiveEventCursor CreateCursor(
        ArchiveEventSummaryItem item)
    {
        return new ArchiveEventCursor(
            OccurredAt: item.OccurredAt,
            ReceivedAt: item.ReceivedAt,
            EventId: item.EventId);
    }

    private void SetError(
        bool loadingMore,
        string message)
    {
        if (loadingMore)
        {
            _loadMoreError = message;
        }
        else
        {
            _error = message;
        }
    }

    private Task ApplyFiltersAsync()
    {
        return LoadEventsAsync();
    }

    private void OpenEventModal(Guid eventId)
    {
        _selectedEventId = eventId;
    }

    private void CloseEventModal()
    {
        _selectedEventId = null;
    }

    private void HandleEventRowKeyDown(
        KeyboardEventArgs eventArgs,
        Guid eventId)
    {
        if (eventArgs.Key is "Enter" or " ")
        {
            OpenEventModal(eventId);
        }
    }

    private async Task ClearFiltersAsync()
    {
        _sourceFilter = null;
        _eventTypeFilter = null;

        await LoadEventsAsync();
    }

    private Task LoadOlderAsync()
    {
        return LoadEventsAsync(append: true);
    }

    private Task HandleFilterKeyDown(
        KeyboardEventArgs eventArgs)
    {
        return eventArgs.Key == "Enter" && !IsBusy
            ? ApplyFiltersAsync()
            : Task.CompletedTask;
    }
}

@page "/services"

@inject IAgentSnapshotClient AgentClient
@inject IOptions<ServiceCatalogOptions> CatalogOptions
@inject IDashboardDateTimeFormatter DateTimeFormatter

<PageTitle>Services</PageTitle>

<header class="page-header">
    <div class="page-eyebrow">
        Service operations
    </div>

    <h1>Services</h1>

    <p class="page-description">
        Inspect applications, protocols, Mission Control components,
        and operational infrastructure from one workspace.
    </p>
</header>

<section class="snapshot-panel">
    <div class="snapshot-copy">
        <div class="snapshot-heading">
            <span class="snapshot-indicator
                @(_snapshot?.Stale == false
                    ? "snapshot-fresh"
                    : "snapshot-warning")">
            </span>

            <div>
                <div class="snapshot-title">
                    Agent snapshot
                </div>

                @if (_isLoading)
                {
                    <div class="snapshot-meta">
                        Loading node status...
                    </div>
                }
                else if (_snapshot is not null)
                {
                    <div class="snapshot-meta">
                        Node <strong>@_snapshot.Node</strong>
                        · Captured
                        <strong>
                            @DateTimeFormatter.Format(
                                _snapshot.CapturedAt)
                        </strong>
                        · Age
                        <strong>
                            @_snapshot.AgeSeconds seconds
                        </strong>
                    </div>
                }
                else
                {
                    <div class="snapshot-meta snapshot-error">
                        @(_snapshotError ??
                            "No Agent snapshot is available.")
                    </div>
                }
            </div>
        </div>

        <div class="snapshot-chips">
            @if (_snapshot?.Stale == true)
            {
                <span class="service-chip status-missing">
                    STALE
                </span>
            }
            else if (_snapshot is not null)
            {
                <span class="service-chip status-running">
                    FRESH
                </span>
            }

            <span class="service-chip @GetPublishStateClass()">
                @GetPublishState()
            </span>

            @if (_snapshot?.LastMissionControlPublishAttemptAt is not null)
            {
                <span class="snapshot-publish-attempt">
                    Last publish
                    <strong>
                        @DateTimeFormatter.Format(
                            _snapshot
                                .LastMissionControlPublishAttemptAt
                                .Value)
                    </strong>
                </span>
            }
        </div>
    </div>

    <button type="button"
            class="btn btn-outline-primary"
            disabled="@_isLoading"
            @onclick="RefreshSnapshotAsync">
        @(_isLoading ? "Refreshing..." : "Refresh")
    </button>
</section>

<section class="service-stats"
         aria-label="Service summary">
    <div class="service-stat">
        <span>Configured services</span>
        <strong>@(TheServices.Count.ToString("N0"))</strong>
    </div>

    <div class="service-stat service-stat-accent">
        <span>Running containers</span>
        <strong>@(RunningContainerCount.ToString("N0"))</strong>
    </div>

    <div class="service-stat">
        <span>Public services</span>
        <strong>@(PublicServiceCount.ToString("N0"))</strong>
    </div>

    <div class="service-stat">
        <span>Snapshot containers</span>
        <strong>
            @((_snapshot?.Containers.Count ?? 0).ToString("N0"))
        </strong>
    </div>

    <div class="service-stat">
        <span>Successful probes</span>
        <strong>@(SuccessfulProtocolCount.ToString("N0"))</strong>
    </div>

    <div class="service-stat">
        <span>Failed probes</span>
        <strong>@(FailedProtocolCount.ToString("N0"))</strong>
    </div>
</section>

<section class="service-toolbar">
    <div>
        <label for="service-filter"
               class="form-label">
            Filter services
        </label>

        <input id="service-filter"
               type="search"
               class="form-control"
               placeholder="Name, protocol, probe, container, endpoint..."
               autocomplete="off"
               @bind="_filter"
               @bind:event="oninput" />
    </div>

    <div class="service-result-count">
        @(TheServices.Count(MatchesFilter).ToString("N0"))
        matching services
    </div>
</section>

@if (UncataloguedContainers.Any())
{
    <section class="uncatalogued-panel"
             aria-label="Uncatalogued containers">
        <div class="uncatalogued-heading">
            <strong>Uncatalogued snapshot containers</strong>
            <span>
                Add these to services.json when they are expected.
            </span>
        </div>

        <div class="uncatalogued-list">
            @foreach (AgentContainerStatusItem container
                in UncataloguedContainers)
            {
                <div class="uncatalogued-item">
                    <strong>@container.Name</strong>
                    <span>@container.State</span>
                    <span>@FormatMemory(container)</span>
                    <span>@($"{container.CpuPercent:0.##}% CPU")</span>
                </div>
            }
        </div>
    </section>
}

@if (UncataloguedProtocols.Any())
{
    <section class="uncatalogued-panel"
             aria-label="Uncatalogued protocol probes">
        <div class="uncatalogued-heading">
            <strong>Uncatalogued protocol probes</strong>
            <span>
                Map these probe keys to a service when they are expected.
            </span>
        </div>

        <div class="uncatalogued-list">
            @foreach (AgentProtocolStatusItem protocol
                in UncataloguedProtocols)
            {
                <div class="uncatalogued-item">
                    <strong>@protocol.Service</strong>
                    <span>
                        @(protocol.Succeeded ? "Succeeded" : "Failed")
                    </span>
                    <span>
                        @FormatDuration(
                            protocol.DurationMilliseconds)
                    </span>
                </div>
            }
        </div>
    </section>
}

@if (!HasFilteredServices)
{
    <div class="alert alert-info">
        No services matched that filter.
    </div>
}
else
{
    @foreach (var group in FilteredGroups)
    {
        <section class="service-group">
            <div class="service-group-heading">
                <div>
                    <div class="page-eyebrow">
                        Service group
                    </div>

                    <h2>@group.Key</h2>
                </div>

                <span>
                    @(group.Count().ToString("N0"))
                    services
                </span>
            </div>

            <div class="service-list">
                @foreach (ServiceDefinition service in group)
                {
                    AgentContainerStatusItem? container =
                        FindContainer(service);

                    AgentProtocolStatusItem? protocol =
                        FindProtocol(service);

                    <details class="service-entry">
                        <summary>
                            <div class="service-summary-copy">
                                <strong>@service.Name</strong>
                                <span>@service.Summary</span>
                            </div>

                            <div class="service-chips">
                                <span class="service-chip
                                    @GetVisibilityClass(
                                        service.Visibility)">
                                    @service.Visibility.ToUpperInvariant()
                                </span>

                                <span class="service-chip
                                    @GetContainerStateClass(
                                        service)">
                                    @GetContainerState(service)
                                </span>

                                @if (HasProtocolServiceKey(service))
                                {
                                    <span class="service-chip
                                        @GetProtocolStateClass(
                                            service)">
                                        @GetProtocolState(service)
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    service.Protocol))
                                {
                                    <span class="service-chip
                                        chip-protocol">
                                        @service.Protocol
                                    </span>
                                }
                            </div>
                        </summary>

                        <div class="service-entry-body">
                            <div class="service-meta-grid">
                                <div class="service-meta">
                                    <span>Container</span>
                                    <strong>
                                        @(container?.Name ??
                                            service.ContainerName ??
                                            "—")
                                    </strong>
                                </div>

                                <div class="service-meta">
                                    <span>Endpoint</span>
                                    <strong>
                                        @(service.Endpoint ?? "—")
                                    </strong>
                                </div>

                                <div class="service-meta">
                                    <span>Image</span>
                                    <strong>
                                        @(service.Image ?? "—")
                                    </strong>
                                </div>

                                <div class="service-meta">
                                    <span>CPU</span>
                                    <strong>
                                        @(container is null
                                            ? "—"
                                            : $"{container.CpuPercent:0.##}%")
                                    </strong>
                                </div>

                                <div class="service-meta">
                                    <span>Memory</span>
                                    <strong>
                                        @(container is null
                                            ? "—"
                                            : FormatMemory(container))
                                    </strong>
                                </div>

                                <div class="service-meta">
                                    <span>Restarts</span>
                                    <strong>
                                        @(container?.RestartCount
                                            .ToString("N0") ?? "—")
                                    </strong>
                                </div>

                                @if (HasProtocolServiceKey(service))
                                {
                                    <div class="service-meta">
                                        <span>Probe service</span>
                                        <strong>
                                            @service.ProtocolServiceKey
                                        </strong>
                                    </div>

                                    <div class="service-meta">
                                        <span>Live probe</span>
                                        <strong>
                                            @GetProtocolDetail(protocol)
                                        </strong>
                                    </div>

                                    <div class="service-meta">
                                        <span>Probe latency</span>
                                        <strong>
                                            @(protocol is null
                                                ? "—"
                                                : FormatDuration(
                                                    protocol
                                                        .DurationMilliseconds))
                                        </strong>
                                    </div>
                                }
                            </div>

                            <p class="service-description">
                                @service.Description
                            </p>

                            @if (service.ApplicationUrl is not null ||
                                 service.SourceUrl is not null)
                            {
                                <div class="service-actions">
                                    @if (service.ApplicationUrl is not null)
                                    {
                                        <a class="btn btn-primary"
                                           href="@service.ApplicationUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            Open service
                                        </a>
                                    }

                                    @if (service.SourceUrl is not null)
                                    {
                                        <a class="btn btn-outline-primary"
                                           href="@service.SourceUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            View source
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        </section>
    }
}

@code {
    private AgentSnapshotItem? _snapshot;
    private bool _isLoading = true;
    private string? _snapshotError;
    private string? _filter;

    private IReadOnlyList<ServiceDefinition> TheServices =>
        CatalogOptions.Value.Services;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot =
                await AgentClient.GetSnapshotAsync();
        }
        catch (Exception exception)
            when (exception is
                HttpRequestException or
                TaskCanceledException or
                InvalidOperationException)
        {
            _snapshotError = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private AgentContainerStatusItem? FindContainer(
        ServiceDefinition service)
    {
        if (string.IsNullOrWhiteSpace(
            service.ContainerName))
        {
            return null;
        }

        return _snapshot?.Containers.FirstOrDefault(
            container =>
                string.Equals(
                    container.Name,
                    service.ContainerName,
                    StringComparison.OrdinalIgnoreCase));
    }

    private static string FormatBytes(
        long bytes)
    {
        string[] units =
            ["B", "KB", "MB", "GB", "TB"];

        double value = bytes;
        int unit = 0;

        while (value >= 1024 &&
               unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    private static string FormatDuration(
        double durationMilliseconds)
    {
        return $"{durationMilliseconds:0.#} ms";
    }

    private static string FormatMemory(
        AgentContainerStatusItem container)
    {
        string usage =
            FormatBytes(container.MemoryUsageBytes);

        string limit = container.MemoryLimitBytes > 0
            ? FormatBytes(container.MemoryLimitBytes)
            : "No limit";

        string percent = container.MemoryLimitBytes > 0
            ? $"{container.MemoryPercent:0.#}%"
            : "—";

        return $"{usage} / {limit} ({percent})";
    }

    private async Task RefreshSnapshotAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _snapshotError = null;

        try
        {
            _snapshot =
                await AgentClient.GetSnapshotAsync();
        }
        catch (Exception exception)
            when (exception is
                HttpRequestException or
                TaskCanceledException or
                InvalidOperationException)
        {
            _snapshotError = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetContainerState(
        ServiceDefinition service)
    {
        AgentContainerStatusItem? container =
            FindContainer(service);

        if (container is not null)
        {
            return container.State.ToUpperInvariant();
        }

        return _snapshot is null
            ? "UNKNOWN"
            : "MISSING";
    }

    private string GetContainerStateClass(
        ServiceDefinition service)
    {
        return GetContainerState(service) switch
        {
            "RUNNING" => "status-running",
            "MISSING" => "status-missing",
            "EXITED" or "STOPPED" => "status-stopped",
            _ => "status-unknown"
        };
    }

    private static string GetVisibilityClass(
        string visibility)
    {
        return visibility.ToUpperInvariant() switch
        {
            "PUBLIC" => "visibility-public",
            "PRIVATE" => "visibility-private",
            _ => "visibility-internal"
        };
    }

    private string GetPublishState()
    {
        return _snapshot?.MissionControlPublishSucceeded switch
        {
            true => "EVENT PUBLISH OK",
            false => "EVENT PUBLISH FAILED",
            _ => "EVENT PUBLISH UNKNOWN"
        };
    }

    private string GetPublishStateClass()
    {
        return _snapshot?.MissionControlPublishSucceeded switch
        {
            true => "status-running",
            false => "status-stopped",
            _ => "status-unknown"
        };
    }

    private IEnumerable<IGrouping<string, ServiceDefinition>>
        FilteredGroups =>
            TheServices
                .Where(MatchesFilter)
                .OrderBy(service => service.Group)
                .ThenBy(service => service.Name)
                .GroupBy(service => service.Group);

    private int RunningContainerCount =>
        TheServices.Count(service =>
            string.Equals(
                FindContainer(service)?.State,
                "running",
                StringComparison.OrdinalIgnoreCase));

    private int PublicServiceCount =>
        TheServices.Count(service =>
            string.Equals(
                service.Visibility,
                "Public",
                StringComparison.OrdinalIgnoreCase));

    private int SuccessfulProtocolCount =>
        _snapshot?.Protocols.Count(protocol => protocol.Succeeded) ?? 0;

    private int FailedProtocolCount =>
        _snapshot?.Protocols.Count(protocol => !protocol.Succeeded) ?? 0;

    private IEnumerable<AgentContainerStatusItem>
        UncataloguedContainers =>
            _snapshot?.Containers.Where(container =>
                !TheServices.Any(service =>
                    string.Equals(
                        service.ContainerName,
                        container.Name,
                        StringComparison.OrdinalIgnoreCase))) ??
            [];

    private IEnumerable<AgentProtocolStatusItem>
        UncataloguedProtocols =>
            _snapshot?.Protocols.Where(protocol =>
                !TheServices.Any(service =>
                    string.Equals(
                        service.ProtocolServiceKey,
                        protocol.Service,
                        StringComparison.OrdinalIgnoreCase))) ??
            [];

    private bool HasFilteredServices =>
        FilteredGroups.Any();

    private bool MatchesFilter(
        ServiceDefinition service)
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            return true;
        }

        string filter = _filter.Trim();

        return Contains(service.Name, filter) ||
               Contains(service.Group, filter) ||
               Contains(service.Summary, filter) ||
               Contains(service.Description, filter) ||
               Contains(service.ContainerName, filter) ||
               Contains(service.Protocol, filter) ||
               Contains(service.ProtocolServiceKey, filter) ||
               Contains(service.Endpoint, filter) ||
               Contains(service.Image, filter) ||
               service.SearchTerms.Any(
                   term => Contains(term, filter));
    }

    private static bool Contains(
        string? value,
        string filter)
    {
        return value?.Contains(
            filter,
            StringComparison.OrdinalIgnoreCase) == true;
    }

    private AgentProtocolStatusItem? FindProtocol(
        ServiceDefinition service)
    {
        if (string.IsNullOrWhiteSpace(
            service.ProtocolServiceKey))
        {
            return null;
        }

        return _snapshot?.Protocols.FirstOrDefault(
            protocol =>
                string.Equals(
                    protocol.Service,
                    service.ProtocolServiceKey,
                    StringComparison.OrdinalIgnoreCase));
    }

    private string GetProtocolStateClass(
        ServiceDefinition service)
    {
        AgentProtocolStatusItem? protocol =
            FindProtocol(service);

        if (_snapshot is null)
        {
            return "status-unknown";
        }

        if (protocol is null)
        {
            return "status-warning";
        }

        return protocol.Succeeded
            ? "status-running"
            : "status-stopped";
    }

    private string GetProtocolState(
        ServiceDefinition service)
    {
        AgentProtocolStatusItem? protocol =
            FindProtocol(service);

        if (_snapshot is null)
        {
            return "PROBE UNKNOWN";
        }

        if (protocol is null)
        {
            return "PROBE MISSING";
        }

        return protocol.Succeeded
            ? $"REACHABLE · {FormatDuration(
                protocol.DurationMilliseconds)}"
            : "PROBE FAILED";
    }

    private string GetProtocolDetail(
        AgentProtocolStatusItem? protocol)
    {
        if (_snapshot is null)
        {
            return "Unavailable";
        }

        if (protocol is null)
        {
            return "Missing";
        }

        return protocol.Succeeded
            ? "Succeeded"
            : "Failed";
    }

    private static bool HasProtocolServiceKey(
        ServiceDefinition service)
    {
        return !string.IsNullOrWhiteSpace(
            service.ProtocolServiceKey);
    }
}

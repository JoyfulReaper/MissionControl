@page "/services"

<PageTitle>Services</PageTitle>

@{
    ServicesView view = CreateView();
}

<header class="page-header">
    <div class="page-eyebrow">
        Service operations
    </div>

    <h1>Services</h1>

    <p class="page-description">
        Inspect applications, protocols, Mission Control components,
        and operational infrastructure from one workspace.
    </p>
</header>

<AgentSnapshotPanel Snapshot="CurrentSnapshot"
                    IsLoading="_agentRefresh.IsInitialLoading"
                    IsRefreshing="_agentRefresh.IsRefreshing"
                    IsManualRefreshing="_isManualRefresh"
                    ErrorMessage="@_agentRefresh.RefreshWarning"
                    OnRefresh="RefreshSnapshotAsync" />

<ServiceSummaryCards ConfiguredServices="view.ConfiguredServices"
                     RunningContainers="view.RunningContainers"
                     PublicServices="view.PublicServices"
                     SnapshotContainers="view.SnapshotContainers"
                     SuccessfulProbes="view.SuccessfulProbes"
                     FailedProbes="view.FailedProbes" />

<section class="service-toolbar">
    <div>
        <label for="service-filter"
               class="form-label">
            Filter services
        </label>

        <input id="service-filter"
               type="search"
               class="form-control"
               placeholder="Name, protocol, probe, container, endpoint..."
               autocomplete="off"
               @bind="_filter"
               @bind:event="oninput" />
    </div>

    <div class="service-result-count">
        @(view.MatchingServices.ToString("N0"))
        matching services
    </div>
</section>

<UncataloguedContainersPanel Containers="view.UncataloguedContainers" />
<UncataloguedProtocolsPanel Protocols="view.UncataloguedProtocols" />

@if (view.Groups.Count == 0)
{
    <div class="alert alert-info">
        No services matched that filter.
    </div>
}
else
{
    @foreach (ServiceGroupView group in view.Groups)
    {
        <section class="service-group">
            <div class="service-group-heading">
                <div>
                    <div class="page-eyebrow">
                        Service group
                    </div>

                    <h2>@group.Name</h2>
                </div>

                <span>
                    @(group.Services.Count.ToString("N0"))
                    services
                </span>
            </div>

            <div class="service-list">
                @foreach (ServiceItemView item in group.Services)
                {
                    <ServiceEntry Service="item.Service"
                                  Container="item.Container"
                                  Protocol="item.Protocol"
                                  IsSnapshotAvailable="@(CurrentSnapshot is not null)"
                                  DockerAvailable="@CurrentSnapshot?.DockerAvailable" />
                }
            </div>
        </section>
    }
}

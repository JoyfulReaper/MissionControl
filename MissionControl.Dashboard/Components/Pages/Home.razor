@page "/"

@implements IAsyncDisposable

@inject IArchiveEventClient ArchiveClient
@inject IAgentSnapshotClient AgentClient
@inject IDashboardDateTimeFormatter DateTimeFormatter
@inject IOptions<DashboardRefreshOptions> RefreshOptions
@inject TimeProvider TimeProvider
@inject IDashboardPollingLoop PollingLoop

<PageTitle>Mission Control</PageTitle>

<header class="page-header">
    <div class="page-eyebrow">
        Operations dashboard
    </div>

    <h1>Mission Control</h1>

    <p class="page-description">
        Inspect archived integration events, trace related activity,
        and investigate payloads without leaving the dashboard.
    </p>
</header>

<section class="overview-section"
         aria-labelledby="archive-overview-title">
    <div class="section-heading">
        <div>
            <div class="page-eyebrow">
                Archive activity
            </div>

            <h2 id="archive-overview-title">
                Event overview
            </h2>
        </div>

        @if (_statistics?.LatestReceivedAt is not null)
        {
            <div class="latest-event">
                Latest receipt
                <strong>
                    @DateTimeFormatter.Format(
                        _statistics.LatestReceivedAt.Value)
                </strong>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <div class="stats-grid">
            @for (int index = 0; index < 4; index++)
            {
                <div class="stat-card stat-card-loading">
                    <span></span>
                    <strong></strong>
                </div>
            }
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }
    else if (_statistics is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <span>Total archived</span>
                <strong>
                    @_statistics.TotalEvents.ToString("N0")
                </strong>
            </div>

            <div class="stat-card stat-card-accent">
                <span>Received in 24 hours</span>
                <strong>
                    @(_statistics.EventsReceivedLast24Hours.ToString("N0"))
                </strong>
            </div>

            <div class="stat-card">
                <span>Event sources</span>
                <strong>
                    @(_statistics.UniqueSources.ToString("N0"))
                </strong>
            </div>

            <div class="stat-card">
                <span>Event types</span>
                <strong>
                    @(_statistics.UniqueEventTypes.ToString("N0"))
                </strong>
            </div>
        </div>

        <div class="category-grid">
            <div class="category-card">
                <h3>Top sources</h3>

                <CategoryList
                    Items="_statistics.TopSources"
                    TotalEvents="_statistics.TotalEvents" />
            </div>

            <div class="category-card">
                <h3>Top event types</h3>

                <CategoryList
                    Items="_statistics.TopEventTypes"
                    TotalEvents="_statistics.TotalEvents" />
            </div>
        </div>
    }
</section>

<section class="overview-section"
         aria-labelledby="node-resources-title">
    <div class="section-heading">
        <div>
            <div class="page-eyebrow">
                Agent snapshot
            </div>

            <h2 id="node-resources-title">
                Node resources
            </h2>
        </div>

        @if (CurrentSnapshot is not null)
        {
            <div class="latest-event">
                Node <strong>@CurrentSnapshot.Node</strong>
                · Captured
                <strong>
                    @DateTimeFormatter.Format(CurrentSnapshot.CapturedAt)
                </strong>
                · Age
                <strong>@CurrentSnapshot.AgeSeconds seconds</strong>
                · @(CurrentSnapshot.Stale ? "Stale" : "Fresh")
            </div>
        }
    </div>

    @if (CurrentSnapshot is not null &&
         !string.IsNullOrWhiteSpace(_agentRefresh.RefreshWarning))
    {
        <div class="alert alert-warning">
            @_agentRefresh.RefreshWarning
        </div>
    }

    <NodeResourceCards Host="CurrentSnapshot?.Host"
                       IsLoading="_agentRefresh.IsInitialLoading"
                       ErrorMessage="@ResourceError" />
</section>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <a class="workspace-card"
           href="events">
            <div class="workspace-card-label">
                Event Archive
            </div>

            <h2>Explore integration events</h2>

            <p>
                Filter by source or event type, page through historical
                activity, and open complete event payloads in place.
            </p>

            <span class="workspace-card-action">
                Open archive →
            </span>
        </a>
    </div>

    <div class="col-lg-5">
        <div class="workspace-card workspace-card-secondary">
            <div class="workspace-card-label">
                Investigation workflow
            </div>

            <h2>Keep your place</h2>

            <p>
                Click an event row for a quick modal inspection, or open
                the full event page when you need a permanent URL.
            </p>
        </div>
    </div>
</div>

@code 
{
    private ArchiveStatisticsItem? _statistics;
    private bool _isLoading = true;
    private string? _error;
    private AgentSnapshotRefreshController _agentRefresh = null!;
    private readonly CancellationTokenSource _disposeSource = new();
    private Task? _pollingTask;
    private bool _disposed;

    private AgentSnapshotItem? CurrentSnapshot =>
        _agentRefresh?.CurrentSnapshot;

    private string? ResourceError =>
        CurrentSnapshot?.Host is null
            ? _agentRefresh.RefreshWarning ??
              NodeResourceCalculations.UnavailableMessage
            : null;

    protected override async Task OnInitializedAsync()
    {
        _agentRefresh = new AgentSnapshotRefreshController(
            AgentClient,
            TimeProvider,
            TimeSpan.FromSeconds(
                RefreshOptions.Value.SnapshotStaleAfterSeconds));

        await Task.WhenAll(
            LoadArchiveStatisticsAsync(),
            _agentRefresh.RefreshAsync(
                _disposeSource.Token));

        _pollingTask = PollingLoop.RunAsync(
            TimeSpan.FromSeconds(
                RefreshOptions.Value.AgentSnapshotRefreshSeconds),
            RefreshAgentSnapshotAsync,
            _disposeSource.Token);
    }

    private async Task LoadArchiveStatisticsAsync()
    {
        try
        {
            _statistics =
                await ArchiveClient.GetStatisticsAsync();
        }
        catch (HttpRequestException exception)
        {
            _error =
                $"Mission Control Archive could not be reached: " +
                exception.Message;
        }
        catch (TaskCanceledException)
        {
            _error =
                "The Mission Control Archive request timed out.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAgentSnapshotAsync(
        CancellationToken cancellationToken)
    {
        await _agentRefresh.RefreshAsync(cancellationToken);

        if (!_disposed && !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _disposeSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}

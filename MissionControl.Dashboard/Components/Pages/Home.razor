@page "/"

@implements IAsyncDisposable

@inject IArchiveEventClient ArchiveClient
@inject IAgentFleetClient AgentFleetClient
@inject IDashboardDateTimeFormatter DateTimeFormatter
@inject IOptions<DashboardRefreshOptions> RefreshOptions
@inject TimeProvider TimeProvider
@inject IDashboardPollingLoop PollingLoop

<PageTitle>Mission Control</PageTitle>

<div class="dashboard-home">
    <header class="page-header">
        <div class="page-eyebrow">
            JoyfulReaper operations
        </div>

        <h1>Mission Control</h1>

        <p class="page-description">
            Live Archive activity, host resources, containers, and protocol status.
        </p>
    </header>

    <ArchiveStatisticsPanel Statistics="_statistics"
                            IsLoading="_archiveIsLoading"
                            IsRefreshing="_archiveIsRefreshing"
                            ErrorMessage="@_archiveError"
                            TimestampFormatter="DateTimeFormatter.Format"
                            OnRefresh="RefreshArchiveStatisticsAsync" />

    <section class="overview-section"
             aria-labelledby="node-resources-title">
        <div class="section-heading">
            <div>
                <div class="page-eyebrow">
                    Current telemetry
                </div>

                <h2 id="node-resources-title">
                    Hosts
                </h2>
            </div>

            <a href="hosts"
               class="btn btn-sm btn-outline-primary">
                View hosts
            </a>
        </div>

        @if (_fleetRefresh.IsInitialLoading)
        {
            <NodeResourceCards IsLoading="true" />
        }
        else if (_fleetRefresh.CurrentNodes.Count == 0)
        {
            <div class="alert alert-warning">
                @(_fleetRefresh.RefreshWarning ??
                    "No Agent nodes are available.")
            </div>
        }
        else
        {
            <div class="overview-hosts">
                @foreach (AgentNodeResult node in _fleetRefresh.CurrentNodes)
                {
                    <section class="overview-host">
                        <div class="overview-host-heading">
                            <div>
                                <div class="overview-host-id">
                                    @node.NodeId
                                </div>

                                <h3>@node.DisplayName</h3>
                            </div>

                            <span class="service-chip @GetNodeStatusClass(node)">
                                @GetNodeStatus(node)
                            </span>
                        </div>

                        <NodeResourceCards Host="node.Snapshot?.Host"
                                           IsLoading="false"
                                           ErrorMessage="@GetResourceError(node)" />
                    </section>
                }
            </div>
        }
    </section>

    @if (CurrentSnapshots.Count > 0)
    {
        <section class="observation-grid"
                 aria-label="Operational observations">
            <article class="observation-card">
                <span>Containers observed</span>

                <strong>
                    @CurrentSnapshots
                    .Sum(snapshot => snapshot.Containers.Count)
                    .ToString("N0")
                </strong>
            </article>

            <article class="observation-card">
                <span>Successful probes</span>

                <strong>
                    @CurrentSnapshots
                    .Sum(snapshot =>
                    snapshot.Protocols.Count(
                    protocol => protocol.Succeeded))
                    .ToString("N0")
                </strong>
            </article>

            <article class="observation-card">
                <span>Failed probes</span>

                <strong>
                    @CurrentSnapshots
                    .Sum(snapshot =>
                    snapshot.Protocols.Count(
                    protocol => !protocol.Succeeded))
                    .ToString("N0")
                </strong>
            </article>
        </section>
    }

    <DailyWorkPickPanel TimestampFormatter="DateTimeFormatter.Format" />
    <QuickAddTodoPanel />
</div>

@code
{
    private ArchiveStatisticsItem? _statistics;
    private bool _archiveIsLoading;
    private bool _archiveIsRefreshing;
    private string? _archiveError;

    private AgentFleetRefreshController _fleetRefresh = null!;

    private readonly CancellationTokenSource
        _disposeSource = new();

    private Task? _pollingTask;
    private bool _disposed;

    private IReadOnlyList<PublicNodeSnapshot> CurrentSnapshots =>
        _fleetRefresh?.CurrentNodes
            .Where(node => node.Snapshot is not null)
            .Select(node => node.Snapshot!)
            .ToArray()
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        _fleetRefresh =
            new AgentFleetRefreshController(
                AgentFleetClient,
                TimeProvider,
                TimeSpan.FromSeconds(
                    RefreshOptions.Value
                        .SnapshotStaleAfterSeconds));

        await Task.WhenAll(
            LoadArchiveStatisticsAsync(
                isManualRefresh: false),
            _fleetRefresh.RefreshAsync(
                _disposeSource.Token));

        _pollingTask =
            PollingLoop.RunAsync(
                TimeSpan.FromSeconds(
                    RefreshOptions.Value
                        .AgentSnapshotRefreshSeconds),
                RefreshFleetAsync,
                _disposeSource.Token);
    }

    private Task RefreshArchiveStatisticsAsync()
    {
        return LoadArchiveStatisticsAsync(
            isManualRefresh: true);
    }

    private async Task LoadArchiveStatisticsAsync(
        bool isManualRefresh)
    {
        if (_archiveIsLoading || _archiveIsRefreshing)
        {
            return;
        }

        _archiveIsLoading =
            _statistics is null;

        _archiveIsRefreshing =
            isManualRefresh;

        try
        {
            _statistics =
                await ArchiveClient.GetStatisticsAsync(
                    _disposeSource.Token);

            _archiveError = null;
        }
        catch (OperationCanceledException)
            when (_disposeSource.IsCancellationRequested)
        {
        }
        catch (HttpRequestException exception)
        {
            _archiveError =
                "Mission Control Archive could not be reached: " +
                exception.Message;
        }
        catch (TaskCanceledException)
        {
            _archiveError =
                "The Mission Control Archive request timed out.";
        }
        finally
        {
            _archiveIsLoading = false;
            _archiveIsRefreshing = false;
        }
    }

    private async Task RefreshFleetAsync(
        CancellationToken cancellationToken)
    {
        await _fleetRefresh.RefreshAsync(
            cancellationToken);

        if (!_disposed &&
            !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetNodeStatus(
        AgentNodeResult node)
    {
        if (!string.IsNullOrWhiteSpace(node.Error))
        {
            return "DEGRADED";
        }

        if (node.Snapshot is null)
        {
            return "UNAVAILABLE";
        }

        if (node.Snapshot.Stale)
        {
            return "STALE";
        }

        return "ONLINE";
    }

    private static string GetNodeStatusClass(
        AgentNodeResult node)
    {
        if (!string.IsNullOrWhiteSpace(node.Error))
        {
            return "status-warning";
        }

        if (node.Snapshot is null ||
            node.Snapshot.Stale)
        {
            return "status-missing";
        }

        return "status-running";
    }

    private static string? GetResourceError(
        AgentNodeResult node)
    {
        if (node.Snapshot?.Host is not null)
        {
            return null;
        }

        return node.Error ??
            NodeResourceCalculations.UnavailableMessage;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        await _disposeSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}
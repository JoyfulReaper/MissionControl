@page "/"

@implements IAsyncDisposable

@inject IArchiveEventClient ArchiveClient
@inject IAgentSnapshotClient AgentClient
@inject IDashboardDateTimeFormatter DateTimeFormatter
@inject IOptions<DashboardRefreshOptions> RefreshOptions
@inject TimeProvider TimeProvider
@inject IDashboardPollingLoop PollingLoop

<PageTitle>Mission Control</PageTitle>

<div class="dashboard-home">
    <header class="page-header">
        <div class="page-eyebrow">
            JoyfulReaper operations
        </div>

        <h1>Mission Control</h1>

        <p class="page-description">
            Live Archive activity, host resources, containers, and protocol status.
        </p>
    </header>

    <ArchiveStatisticsPanel Statistics="_statistics"
                            IsLoading="_archiveIsLoading"
                            IsRefreshing="_archiveIsRefreshing"
                            ErrorMessage="@_archiveError"
                            TimestampFormatter="DateTimeFormatter.Format"
                            OnRefresh="RefreshArchiveStatisticsAsync" />

    <AgentSnapshotPanel Snapshot="CurrentSnapshot"
                        IsLoading="_agentRefresh.IsInitialLoading"
                        IsRefreshing="_agentRefresh.IsRefreshing"
                        IsManualRefreshing="_isManualAgentRefresh"
                        ErrorMessage="@_agentRefresh.RefreshWarning"
                        TimestampFormatter="@(timestamp =>
                            DateTimeFormatter.Format(timestamp))"
                        OnRefresh="RefreshSnapshotAsync" />

    <section class="overview-section"
             aria-labelledby="node-resources-title">
        <div class="section-heading">
            <div>
                <div class="page-eyebrow">
                    Current telemetry
                </div>

                <h2 id="node-resources-title">
                    Node resources
                </h2>
            </div>
        </div>

        <NodeResourceCards Host="CurrentSnapshot?.Host"
                           IsLoading="_agentRefresh.IsInitialLoading"
                           ErrorMessage="@ResourceError" />
    </section>

    @if (CurrentSnapshot is not null)
    {
        <section class="observation-grid"
                 aria-label="Operational observations">
            <article class="observation-card">
                <span>Containers observed</span>
                <strong>
                    @(CurrentSnapshot.Containers.Count.ToString("N0"))
                </strong>
            </article>

            <article class="observation-card">
                <span>Successful probes</span>
                <strong>
                    @(CurrentSnapshot.Protocols
                        .Count(protocol => protocol.Succeeded)
                        .ToString("N0"))
                </strong>
            </article>

            <article class="observation-card">
                <span>Failed probes</span>
                <strong>
                    @(CurrentSnapshot.Protocols
                        .Count(protocol => !protocol.Succeeded)
                        .ToString("N0"))
                </strong>
            </article>
        </section>
    }
</div>

@code 
{
    private ArchiveStatisticsItem? _statistics;
    private bool _archiveIsLoading;
    private bool _archiveIsRefreshing;
    private string? _archiveError;
    private AgentSnapshotRefreshController _agentRefresh = null!;
    private readonly CancellationTokenSource _disposeSource = new();
    private Task? _pollingTask;
    private bool _isManualAgentRefresh;
    private bool _disposed;

    private AgentSnapshotItem? CurrentSnapshot =>
        _agentRefresh?.CurrentSnapshot;

    private string? ResourceError =>
        CurrentSnapshot?.Host is null
            ? _agentRefresh.RefreshWarning ??
              NodeResourceCalculations.UnavailableMessage
            : null;

    protected override async Task OnInitializedAsync()
    {
        _agentRefresh = new AgentSnapshotRefreshController(
            AgentClient,
            TimeProvider,
            TimeSpan.FromSeconds(
                RefreshOptions.Value.SnapshotStaleAfterSeconds));

        await Task.WhenAll(
            LoadArchiveStatisticsAsync(
                isManualRefresh: false),
            _agentRefresh.RefreshAsync(
                _disposeSource.Token));

        _pollingTask = PollingLoop.RunAsync(
            TimeSpan.FromSeconds(
                RefreshOptions.Value.AgentSnapshotRefreshSeconds),
            RefreshAgentSnapshotAsync,
            _disposeSource.Token);
    }

    private Task RefreshArchiveStatisticsAsync()
    {
        return LoadArchiveStatisticsAsync(
            isManualRefresh: true);
    }

    private async Task LoadArchiveStatisticsAsync(
        bool isManualRefresh)
    {
        if (_archiveIsLoading || _archiveIsRefreshing)
        {
            return;
        }

        _archiveIsLoading =
            _statistics is null;

        _archiveIsRefreshing =
            isManualRefresh;

        try
        {
            _statistics =
                await ArchiveClient.GetStatisticsAsync(
                    _disposeSource.Token);

            _archiveError = null;
        }
        catch (OperationCanceledException)
            when (_disposeSource.IsCancellationRequested)
        {
        }
        catch (HttpRequestException exception)
        {
            _archiveError =
                $"Mission Control Archive could not be reached: " +
                exception.Message;
        }
        catch (TaskCanceledException)
        {
            _archiveError =
                "The Mission Control Archive request timed out.";
        }
        finally
        {
            _archiveIsLoading = false;
            _archiveIsRefreshing = false;
        }
    }

    private async Task RefreshSnapshotAsync()
    {
        if (_agentRefresh.IsRefreshing)
        {
            return;
        }

        _isManualAgentRefresh = true;

        try
        {
            await _agentRefresh.RefreshAsync(
                _disposeSource.Token);
        }
        finally
        {
            _isManualAgentRefresh = false;
        }
    }

    private async Task RefreshAgentSnapshotAsync(
        CancellationToken cancellationToken)
    {
        await _agentRefresh.RefreshAsync(cancellationToken);

        if (!_disposed && !cancellationToken.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _disposeSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}

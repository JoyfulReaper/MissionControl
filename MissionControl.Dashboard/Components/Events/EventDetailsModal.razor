@inject IArchiveEventClient ArchiveClient

<div class="modal-backdrop fade show"></div>

<div class="modal d-block"
     tabindex="-1"
     role="dialog"
     aria-modal="true"
     aria-labelledby="event-details-modal-title"
     @onclick="CloseAsync"
     @onkeydown="HandleKeyDown">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"
         role="document"
         @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h1 id="event-details-modal-title"
                    class="modal-title fs-5">
                    Event Details
                </h1>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        autofocus
                        @onclick="CloseAsync">
                </button>
            </div>

            <div class="modal-body">
                @if (_isLoading)
                {
                    <p class="mb-0">
                        Loading event details...
                    </p>
                }
                else if (_error is not null)
                {
                    <div class="alert alert-danger mb-0">
                        @_error
                    </div>
                }
                else if (_event is null)
                {
                    <div class="alert alert-warning mb-0">
                        The requested event was not found.
                    </div>
                }
                else
                {
                    <EventDetailsContent Event="_event" />
                }
            </div>

            <div class="modal-footer">
                <a class="btn btn-outline-primary"
                   href="@($"/events/{EventId:D}")">
                    View full page
                </a>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CloseAsync">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    private ArchiveEventDetailsItem? _event;
    private bool _isLoading;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _error = null;
        _event = null;

        try
        {
            _event = await ArchiveClient.GetByIdAsync(EventId);
        }
        catch (HttpRequestException exception)
        {
            _error =
                $"Mission Control Archive could not be reached: " +
                exception.Message;
        }
        catch (TaskCanceledException)
        {
            _error =
                "The Mission Control Archive request timed out.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task CloseAsync()
    {
        return OnClosed.InvokeAsync();
    }

    private Task HandleKeyDown(
        KeyboardEventArgs eventArgs)
    {
        return eventArgs.Key == "Escape"
            ? CloseAsync()
            : Task.CompletedTask;
    }
}
@page "/login"
@model MissionControl.Dashboard.Pages.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Mission Control Login</title>
</head>

<body>
    <main class="login-panel">
        <h1>Mission Control</h1>
        <p>Authentication required.</p>

        <form method="post">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ReturnUrl"
                   value="@Model.ReturnUrl" />

            <label for="username">
                Username
            </label>

            <input id="username"
                   name="Username"
                   value="@Model.Username"
                   autocomplete="username"
                   autofocus
                   required />

            <label for="password">
                Password
            </label>

            <input id="password"
                   name="Password"
                   type="password"
                   autocomplete="current-password"
                   required />

            @if (Model.InvalidCredentials)
            {
                <div class="error" role="alert">
                    Invalid username or password.
                </div>
            }

            <button type="submit">
                Sign in
            </button>
        </form>
    </main>
</body>
</html>
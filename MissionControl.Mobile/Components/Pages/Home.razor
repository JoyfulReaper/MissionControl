@page "/"

@implements IDisposable
@inject MobileAgentSnapshotState SnapshotState

<PageTitle>Mission Control</PageTitle>

<div class="mobile-dashboard">
    <header class="mobile-header">
        <div class="mobile-eyebrow">
            JoyfulReaper operations
        </div>

        <h1>Mission Control</h1>

        <p>
            Live host, container, and protocol status from the
            Mission Control Agent.
        </p>
    </header>

    <AgentSnapshotPanel Snapshot="SnapshotState.Snapshot"
                        IsLoading="SnapshotState.IsInitialLoading"
                        IsRefreshing="SnapshotState.IsRefreshing"
                        IsManualRefreshing="SnapshotState.IsManualRefreshing"
                        ErrorMessage="@SnapshotState.ErrorMessage"
                        TimestampFormatter="FormatTimestamp"
                        OnRefresh="RefreshSnapshotAsync" />

    <section class="mobile-section"
             aria-labelledby="node-resources-title">
        <div class="mobile-section-heading">
            <div>
                <div class="mobile-eyebrow">
                    Current telemetry
                </div>

                <h2 id="node-resources-title">
                    Node resources
                </h2>
            </div>
        </div>

        <NodeResourceCards Host="SnapshotState.Snapshot?.Host"
                           IsLoading="SnapshotState.IsInitialLoading"
                           ErrorMessage="@SnapshotState.ErrorMessage" />
    </section>

    @if (SnapshotState.Snapshot is not null)
    {
        <section class="mobile-observation-grid">
            <article class="mobile-observation-card">
                <span>Containers observed</span>
                <strong>
                    @(SnapshotState.Snapshot.Containers.Count.ToString("N0"))
                </strong>
            </article>

            <article class="mobile-observation-card">
                <span>Successful probes</span>
                <strong>
                    @(SnapshotState.Snapshot.Protocols
                    .Count(protocol => protocol.Succeeded)
                    .ToString("N0"))
                </strong>
            </article>

            <article class="mobile-observation-card">
                <span>Failed probes</span>
                <strong>
                    @(SnapshotState.Snapshot.Protocols
                    .Count(protocol => !protocol.Succeeded)
                    .ToString("N0"))
                </strong>
            </article>
        </section>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        SnapshotState.Changed += HandleSnapshotStateChanged;

        await SnapshotState.EnsureLoadedAsync();
    }

    private Task RefreshSnapshotAsync()
    {
        return SnapshotState.RefreshAsync(
            isManualRefresh: true);
    }

    private void HandleSnapshotStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SnapshotState.Changed -= HandleSnapshotStateChanged;
    }

    private static string FormatTimestamp(
        DateTimeOffset timestamp)
    {
        return timestamp
            .ToLocalTime()
            .ToString("yyyy-MM-dd HH:mm:ss zzz");
    }
}
@page "/"

@implements IAsyncDisposable

@inject MobileHostFleetState HostFleetState
@inject IArchiveEventClient ArchiveClient
@inject MobileApiCredentialStore CredentialStore

<PageTitle>Mission Control</PageTitle>

<div class="mobile-dashboard">
    <header class="mobile-header">
        <div class="mobile-eyebrow">
            JoyfulReaper operations
        </div>

        <h1>Mission Control</h1>

        <p>
            Live Archive activity, host resources,
            containers, and protocol status.
        </p>
    </header>

    @if (!_configurationChecked)
    {
        <div class="alert alert-info">
            Checking Mobile API configuration...
        </div>
    }
    else if (!_hasMobileApiToken)
    {
        <div class="alert alert-warning">
            <div>
                Configure the Mobile API token to view
                Archive activity, hosts, and Work Planning.
            </div>

            <NavLink class="alert-link"
                     href="settings">
                Open Settings
            </NavLink>
        </div>
    }
    else
    {
        <ArchiveStatisticsPanel Statistics="_archiveStatistics"
                                IsLoading="_archiveIsLoading"
                                IsRefreshing="_archiveIsRefreshing"
                                ErrorMessage="@_archiveError"
                                TimestampFormatter="FormatTimestamp"
                                OnRefresh="RefreshArchiveStatisticsAsync" />
    }

    <section class="mobile-section"
             aria-labelledby="hosts-title">
        <div class="mobile-section-heading">
            <div>
                <div class="mobile-eyebrow">
                    Current telemetry
                </div>

                <h2 id="hosts-title">
                    Hosts
                </h2>
            </div>

            <NavLink class="btn btn-sm btn-outline-primary"
                     href="hosts">
                View hosts
            </NavLink>
        </div>

        @if (!_hasMobileApiToken)
        {
            <div class="alert alert-secondary">
                Host telemetry requires the Mobile API token.
            </div>
        }
        else if (HostFleetState.IsInitialLoading)
        {
            <NodeResourceCards IsLoading="true" />
        }
        else if (HostFleetState.Hosts.Count == 0)
        {
            <div class="alert alert-warning">
                @(HostFleetState.ErrorMessage ??
                    "No Mission Control hosts are available.")
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(
                    HostFleetState.ErrorMessage))
            {
                <div class="alert alert-warning">
                    @HostFleetState.ErrorMessage
                </div>
            }

            <div class="mobile-host-overview">
                @foreach (HostNodeSnapshot host
                    in HostFleetState.Hosts)
                {
                    <section class="mobile-host-summary">
                        <div class="mobile-host-summary-heading">
                            <div>
                                <div class="mobile-host-id">
                                    @host.NodeId
                                </div>

                                <h3>
                                    @host.DisplayName
                                </h3>
                            </div>

                            <span class="@GetStatusClass(host)">
                                @GetStatus(host)
                            </span>
                        </div>

                        <NodeResourceCards Host="host.AgentSnapshot?.Host"
                                           IsLoading="false"
                                           ErrorMessage="@GetResourceError(host)" />
                    </section>
                }
            </div>
        }
    </section>

    @if (CurrentSnapshots.Count > 0)
    {
        <section class="mobile-observation-grid"
                 aria-label="Operational observations">
            <article class="mobile-observation-card">
                <span>Containers observed</span>

                <strong>
                    @(CurrentSnapshots
                        .Sum(snapshot =>
                            snapshot.Containers.Count)
                        .ToString("N0"))
                </strong>
            </article>

            <article class="mobile-observation-card">
                <span>Successful probes</span>

                <strong>
                    @(CurrentSnapshots
                        .Sum(snapshot =>
                            snapshot.Protocols.Count(
                                protocol =>
                                    protocol.Succeeded))
                        .ToString("N0"))
                </strong>
            </article>

            <article class="mobile-observation-card">
                <span>Failed probes</span>

                <strong>
                    @(CurrentSnapshots
                        .Sum(snapshot =>
                            snapshot.Protocols.Count(
                                protocol =>
                                    !protocol.Succeeded))
                        .ToString("N0"))
                </strong>
            </article>
        </section>
    }

    @if (_hasMobileApiToken)
    {
        <DailyWorkPickPanel TimestampFormatter="FormatTimestamp" />

        <QuickAddTodoPanel />
    }
</div>

@code {
    private static readonly TimeSpan PollingInterval = TimeSpan.FromSeconds(30);
    private readonly CancellationTokenSource _disposeSource = new();

    private ArchiveStatisticsItem? _archiveStatistics;
    private string? _archiveError;
    private bool _configurationChecked;
    private bool _archiveIsLoading;
    private bool _archiveIsRefreshing;
    private bool _hasMobileApiToken;

    private Task? _fleetPollingTask;

    private IReadOnlyList<PublicNodeSnapshot> CurrentSnapshots =>
        HostFleetState.Hosts
            .Where(host =>
                host.AgentSnapshot is not null)
            .Select(host =>
                host.AgentSnapshot!)
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        HostFleetState.Changed += HandleHostFleetStateChanged;

        try
        {
            string? token = await CredentialStore.GetTokenAsync();

            _hasMobileApiToken = !string.IsNullOrWhiteSpace(token);
            _configurationChecked = true;

            if (_hasMobileApiToken)
            {
                await Task.WhenAll(
                    LoadArchiveStatisticsAsync(
                        isManualRefresh: false),
                    HostFleetState.EnsureLoadedAsync(
                        _disposeSource.Token));

                _fleetPollingTask =
                    HostFleetState.RunPollingAsync(
                        PollingInterval,
                        _disposeSource.Token);
            }
        }
        catch (Exception exception)
        {
            _configurationChecked = true;

            _archiveError =
                "Could not read the Mobile API configuration: " +
                exception.Message;
        }
    }

    private Task RefreshArchiveStatisticsAsync()
    {
        return LoadArchiveStatisticsAsync(
            isManualRefresh: true);
    }

    private async Task LoadArchiveStatisticsAsync(
        bool isManualRefresh)
    {
        if (_archiveIsLoading ||
            _archiveIsRefreshing)
        {
            return;
        }

        _archiveIsLoading = _archiveStatistics is null;
        _archiveIsRefreshing = isManualRefresh;

        try
        {
            _archiveStatistics =
                await ArchiveClient.GetStatisticsAsync(
                    _disposeSource.Token);

            _archiveError = null;
        }
        catch (OperationCanceledException)
            when (_disposeSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
            when (exception is
                HttpRequestException or
                TaskCanceledException or
                InvalidOperationException)
        {
            _archiveError =
                CreateArchiveErrorMessage(
                    exception);
        }
        finally
        {
            _archiveIsLoading = false;
            _archiveIsRefreshing = false;
        }
    }

    private static string CreateArchiveErrorMessage(
        Exception exception)
    {
        return exception switch
        {
            HttpRequestException
            {
                StatusCode:
                    System.Net.HttpStatusCode.Unauthorized
            } =>
                "The Dashboard rejected the Mobile API token. " +
                "Update it in Settings.",

            HttpRequestException
            {
                StatusCode:
                    System.Net.HttpStatusCode.BadGateway
            } =>
                "The Dashboard could not reach the " +
                "Mission Control Archive.",

            HttpRequestException =>
                "Archive statistics could not be retrieved: " +
                exception.Message,

            TaskCanceledException =>
                "The Archive statistics request timed out.",

            _ =>
                exception.Message
        };
    }

    private void HandleHostFleetStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetStatus(
        HostNodeSnapshot host)
    {
        if (!string.IsNullOrWhiteSpace(
                host.AgentError))
        {
            return "DEGRADED";
        }

        if (host.AgentSnapshot is null)
        {
            return "UNAVAILABLE";
        }

        if (host.AgentSnapshot.Stale)
        {
            return "STALE";
        }

        return "ONLINE";
    }

    private static string GetStatusClass(
        HostNodeSnapshot host)
    {
        return GetStatus(host) switch
        {
            "ONLINE" =>
                "badge text-bg-success",

            "DEGRADED" or "STALE" =>
                "badge text-bg-warning",

            _ =>
                "badge text-bg-secondary"
        };
    }

    private static string? GetResourceError(
        HostNodeSnapshot host)
    {
        if (host.AgentSnapshot?.Host is not null)
        {
            return null;
        }

        return host.AgentError ??
            "Host resource telemetry is unavailable.";
    }

    private static string FormatTimestamp(
        DateTimeOffset timestamp)
    {
        return timestamp
            .ToLocalTime()
            .ToString("yyyy-MM-dd HH:mm:ss zzz");
    }

    public async ValueTask DisposeAsync()
    {
        HostFleetState.Changed -= HandleHostFleetStateChanged;

        await _disposeSource.CancelAsync();

        if (_fleetPollingTask is not null)
        {
            try
            {
                await _fleetPollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}
@page "/events"
@implements IAsyncDisposable

@inject IArchiveEventClient ArchiveClient
@inject MobileApiCredentialStore CredentialStore

<PageTitle>Events</PageTitle>

<div class="mobile-events-page">
    <header class="mobile-page-header event-page-header">
        <div>
            <div class="page-eyebrow">
                Event archive
            </div>

            <h1>Events</h1>

            <p>
                Inspect recent integration events received by
                Mission Control.
            </p>
        </div>

        <button type="button"
                class="btn btn-outline-primary"
                disabled="@(!_configurationChecked ||
                                        !_hasToken ||
                                        IsBusy)"
                @onclick="RefreshAsync">
            @(IsBusy
                ? "Refreshing..."
                : "Refresh")
        </button>
    </header>

    @if (!_configurationChecked)
    {
        <div class="alert alert-info">
            Checking Mobile API configuration...
        </div>
    }
    else if (_configurationError is not null)
    {
        <div class="alert alert-danger">
            @_configurationError
        </div>
    }
    else if (!_hasToken)
    {
        <div class="alert alert-warning">
            <div>
                A Mobile API token is required to access archived
                events.
            </div>

            <NavLink class="alert-link"
                     href="settings">
                Open Settings
            </NavLink>
        </div>
    }
    else if (_feed is not null)
    {
        <button type="button"
                class="events-filter-toggle"
                aria-expanded="@_filtersExpanded"
                aria-controls="events-filter-panel"
                @onclick="ToggleFilters">
            <span>
                @(_filtersExpanded
                    ? "Hide filters"
                    : "Show filters")
            </span>

            @if (HasActiveFilters)
            {
                <span class="badge text-bg-primary">
                    Filters active
                </span>
            }
        </button>

        <section id="events-filter-panel"
                 class="event-filter-card @(
                 _filtersExpanded
                     ? "event-filter-card-expanded"
                     : null)">
            <div class="event-filter-heading">
                <div>
                    <h2>Filter events</h2>

                    <p>
                        Match events above; hide noisy sources or types below.
                    </p>
                </div>

                @if (HasActiveFilters)
                {
                    <span class="badge text-bg-primary">
                        Filters active
                    </span>
                }
            </div>

            <div class="event-filter-grid">
                <div>
                    <label for="mobile-event-source"
                           class="form-label">
                        Source
                    </label>

                    <input id="mobile-event-source"
                           class="form-control"
                           list="mobile-event-source-options"
                           placeholder="Source"
                           autocomplete="off"
                           @bind="_sourceFilter"
                           @bind:event="oninput"
                           @onkeydown="HandleFilterKeyDown" />

                    <datalist id="mobile-event-source-options">
                        @foreach (
                            string source in
                            _feed.SourceSuggestions)
                        {
                            <option value="@source"></option>
                        }
                    </datalist>
                </div>

                <div>
                    <label for="mobile-event-type"
                           class="form-label">
                        Event type
                    </label>

                    <input id="mobile-event-type"
                           class="form-control"
                           list="mobile-event-type-options"
                           placeholder="Event type"
                           autocomplete="off"
                           @bind="_eventTypeFilter"
                           @bind:event="oninput"
                           @onkeydown="HandleFilterKeyDown" />

                    <datalist id="mobile-event-type-options">
                        @foreach (
                            string eventType in
                            _feed.EventTypeSuggestions)
                        {
                            <option value="@eventType"></option>
                        }
                    </datalist>
                </div>
            </div>

            <div class="event-exclusion-grid">
                <div>
                    <label for="mobile-source-exclusion"
                           class="form-label">
                        Exclude source
                    </label>

                    <div class="event-exclusion-control">
                        <input id="mobile-source-exclusion"
                               class="form-control"
                               list="mobile-event-source-options"
                               placeholder="Hide a source"
                               autocomplete="off"
                               @bind="_sourceExclusion"
                               @bind:event="oninput"
                               @onkeydown="HandleSourceExclusionKeyDown" />

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(_sourceExclusion))"
                                @onclick="ExcludeSource">
                            Hide
                        </button>
                    </div>
                </div>

                <div>
                    <label for="mobile-event-type-exclusion"
                           class="form-label">
                        Exclude event type
                    </label>

                    <div class="event-exclusion-control">
                        <input id="mobile-event-type-exclusion"
                               class="form-control"
                               list="mobile-event-type-options"
                               placeholder="Hide an event type"
                               autocomplete="off"
                               @bind="_eventTypeExclusion"
                               @bind:event="oninput"
                               @onkeydown="HandleEventTypeExclusionKeyDown" />

                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(_eventTypeExclusion))"
                                @onclick="ExcludeEventTypeFromInput">
                            Hide
                        </button>
                    </div>
                </div>
            </div>

            @if (HasExclusions)
            {
                <div class="event-exclusion-summary">
                    @if (_excludedSources.Count > 0)
                    {
                        <div class="event-exclusion-group">
                            <span class="event-exclusion-label">
                                Hidden sources
                            </span>

                            <div class="event-exclusion-chips">
                                @foreach (string source in
                                    _excludedSources.OrderBy(
                                        value => value,
                                        StringComparer.OrdinalIgnoreCase))
                                {
                                    <button type="button"
                                            class="event-exclusion-chip"
                                            title="Show @source again"
                                            @onclick="() => IncludeSource(source)">
                                        @source
                                        <span aria-hidden="true">×</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_excludedEventTypes.Count > 0)
                    {
                        <div class="event-exclusion-group">
                            <span class="event-exclusion-label">
                                Hidden event types
                            </span>

                            <div class="event-exclusion-chips">
                                @foreach (string eventType in
                                    _excludedEventTypes.OrderBy(
                                        value => value,
                                        StringComparer.OrdinalIgnoreCase))
                                {
                                    <button type="button"
                                            class="event-exclusion-chip"
                                            title="Show @eventType again"
                                            @onclick="() => IncludeEventType(eventType)">
                                        @eventType
                                        <span aria-hidden="true">×</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="event-filter-actions">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@IsBusy"
                        @onclick="ApplyFiltersAsync">
                    Apply filters
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@(
                        IsBusy ||
                        !HasActiveFilters)"
                        @onclick="ClearFiltersAsync">
                    Clear
                </button>
            </div>
        </section>

        @if (_feed.RefreshWarning is not null)
        {
            <div class="alert alert-warning">
                @_feed.RefreshWarning
            </div>
        }

        @if (_feed.NewEventsAvailable)
        {
            <div class="alert alert-info event-newest-alert">
                <span>
                    New events are available.
                </span>

                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        disabled="@IsBusy"
                        @onclick="LoadNewestAsync">
                    Load newest
                </button>
            </div>
        }

        @if (_feed.Error is not null)
        {
            <div class="alert alert-danger">
                <div>
                    @_feed.Error
                </div>

                <NavLink class="alert-link"
                         href="settings">
                    Open Settings
                </NavLink>
            </div>
        }
        else if (_feed.IsInitialLoading)
        {
            <div class="event-list event-list-loading"
                 aria-label="Loading archived events">
                @for (int index = 0; index < 5; index++)
                {
                    <div class="event-card event-card-loading">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                }
            </div>
        }
        else if (_visibleEvents.Count == 0)
        {
            <div class="alert alert-info event-empty-state">
                @if (_feed.Events.Count == 0)
                {
                    <span>
                        No archived events matched the current filters.
                    </span>
                }
                else
                {
                    <span>
                        All loaded events are hidden by the current exclusions.
                    </span>
                }

                @if (HasActiveFilters)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            @onclick="ClearFiltersAsync">
                        Clear filters
                    </button>
                }

                @if (_feed.Events.Count > 0 && _feed.HasMore)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@IsBusy"
                            @onclick="LoadOlderAsync">
                        @(_feed.IsLoadingMore
                            ? "Loading..."
                            : "Load older")
                    </button>
                }
            </div>
        }
        else
        {
            <div class="event-results-heading">
                <div>
                    <h2>Recent events</h2>

                    <span>
                        @LoadedEventCountLabel
                    </span>
                </div>

                <span>
                    Newest first
                </span>
            </div>

            <div class="event-list">
                @foreach (
                    ArchiveEventSummaryItem item in
                    _visibleEvents)
                {
                    <article class="event-card event-card-interactive"
                             role="button"
                             tabindex="0"
                             aria-label="Open @item.EventType event from @item.Source"
                             @onclick="() => OpenEventModal(item.EventId)"
                             @onkeydown="eventArgs =>
                                         HandleEventKeyDown(eventArgs, item.EventId)">
                       <div class="event-card-heading">
                            <div>
                                <span class="event-source">
                                    @item.Source
                                </span>

                                <h2 title="@item.EventType">
                                    @item.EventType
                                </h2>
                            </div>

                            <time datetime="@item.OccurredAt.ToString("O")"
                                  title="@FormatTimestamp(item.OccurredAt)">
                                @FormatRelativeTimestamp(item.OccurredAt)
                            </time>
                        </div>

                        <dl class="event-meta">
                            <div>
                                <dt>Schema</dt>
                                <dd>@item.SchemaVersion</dd>
                            </div>

                            <div>
                                <dt>Correlation</dt>
                                <dd>
                                    <code title="@item.CorrelationId">
                                        @(item.CorrelationId ?? "—")
                                    </code>
                                </dd>
                            </div>

                            <div>
                                <dt>Received</dt>
                                <dd>
                                    <time datetime="@item.ReceivedAt.ToString("O")"
                                          title="@FormatRelativeTimestamp(item.ReceivedAt)">
                                        @FormatTimestamp(item.ReceivedAt)
                                    </time>
                                </dd>
                            </div>
                        </dl>

                        <div class="event-card-actions">
                            <button type="button"
                                    class="event-hide-action"
                                    title="Hide all @item.EventType events"
                                    aria-label="Hide all @item.EventType events"
                                    @onclick="() => ExcludeEventType(item.EventType)"
                                    @onclick:stopPropagation="true"
                                    @onkeydown:stopPropagation="true">
                                Hide type
                            </button>
                        </div>
                    </article>
                }
            </div>

            @if (_feed.LoadMoreError is not null)
            {
                <div class="alert alert-danger">
                    @_feed.LoadMoreError
                </div>
            }

            @if (_feed.HasMore)
            {
                <div class="load-more">
                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@IsBusy"
                            @onclick="LoadOlderAsync">
                        @(_feed.IsLoadingMore
                            ? "Loading older events..."
                            : "Load older")
                    </button>
                </div>
            }
        }
    }
</div>

@if (_feed?.SelectedEventId is Guid selectedEventId)
{
    <MobileEventDetailsModal @key="selectedEventId"
                             EventId="selectedEventId"
                             OnClosed="CloseEventModal" />
}

@code {
    private readonly CancellationTokenSource _disposeSource =
        new();

    private EventFeedController? _feed;
    private string? _sourceFilter;
    private string? _eventTypeFilter;
    private string? _sourceExclusion;
    private string? _eventTypeExclusion;
    private readonly HashSet<string> _excludedSources =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _excludedEventTypes =
        new(StringComparer.OrdinalIgnoreCase);
    private string? _configurationError;
    private bool _configurationChecked;
    private bool _hasToken;
    private bool _filtersExpanded;

    private Task? _relativeTimeRefreshTask;

    private bool IsBusy =>
        _feed?.IsRefreshing == true;

    private IReadOnlyList<ArchiveEventSummaryItem> _visibleEvents =>
        _feed is null
            ? []
            : _feed.Events
                .Where(item =>
                    !_excludedSources.Contains(item.Source) &&
                    !_excludedEventTypes.Contains(item.EventType))
                .ToArray();

    private bool HasExclusions =>
        _excludedSources.Count > 0 ||
        _excludedEventTypes.Count > 0;

    private bool HasActiveFilters =>
        _feed?.HasActiveFilters == true ||
        HasExclusions;

    private string LoadedEventCountLabel =>
        _feed is null
            ? "0 loaded"
            : HasExclusions
                ? $"{_visibleEvents.Count:N0} visible · {_feed.Events.Count:N0} loaded"
                : $"{_feed.Events.Count:N0} loaded";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string? token = await CredentialStore.GetTokenAsync();
            _hasToken = !string.IsNullOrWhiteSpace(token);

            _configurationChecked = true;

            if (!_hasToken)
            {
                return;
            }

            _feed = new EventFeedController(ArchiveClient);
            await _feed.LoadInitialAsync( _disposeSource.Token);

            _relativeTimeRefreshTask = RefreshRelativeTimestampsAsync(_disposeSource.Token);
        }
        catch (OperationCanceledException)
            when (_disposeSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _configurationError =
                $"Could not initialize the event archive: " +
                exception.Message;

            _configurationChecked = true;
        }
    }

    private Task RefreshAsync()
    {
        return _feed is null
            ? Task.CompletedTask
            : _feed.PollAsync(
                _disposeSource.Token);
    }

    private void ToggleFilters()
    {
        _filtersExpanded =
            !_filtersExpanded;
    }

    private async Task ApplyFiltersAsync()
    {
        if (_feed is null)
        {
            return;
        }

        _feed.SourceFilter =
            _sourceFilter;

        _feed.EventTypeFilter =
            _eventTypeFilter;

        await _feed.ApplyFiltersAsync(
            _disposeSource.Token);
    }

    private async Task ClearFiltersAsync()
    {
        if (_feed is null)
        {
            return;
        }

        _sourceFilter = null;
        _eventTypeFilter = null;
        _sourceExclusion = null;
        _eventTypeExclusion = null;
        _excludedSources.Clear();
        _excludedEventTypes.Clear();

        await _feed.ClearFiltersAsync(
            _disposeSource.Token);
    }

    private void ExcludeSource()
    {
        string? source = NormalizeExclusion(_sourceExclusion);

        if (source is null)
        {
            return;
        }

        _excludedSources.Add(source);
        _sourceExclusion = null;
    }

    private void ExcludeEventTypeFromInput()
    {
        string? eventType = NormalizeExclusion(_eventTypeExclusion);

        if (eventType is null)
        {
            return;
        }

        ExcludeEventType(eventType);
        _eventTypeExclusion = null;
    }

    private void ExcludeEventType(string eventType)
    {
        string? normalized = NormalizeExclusion(eventType);

        if (normalized is not null)
        {
            _excludedEventTypes.Add(normalized);
        }
    }

    private void IncludeSource(string source)
    {
        _excludedSources.Remove(source);
    }

    private void IncludeEventType(string eventType)
    {
        _excludedEventTypes.Remove(eventType);
    }

    private Task LoadOlderAsync()
    {
        return _feed is null
            ? Task.CompletedTask
            : _feed.LoadOlderAsync(
                _disposeSource.Token);
    }

    private Task LoadNewestAsync()
    {
        return _feed is null
            ? Task.CompletedTask
            : _feed.LoadNewestAsync(
                _disposeSource.Token);
    }

    private Task HandleFilterKeyDown(
        KeyboardEventArgs eventArgs)
    {
        return eventArgs.Key == "Enter" &&
               !IsBusy
            ? ApplyFiltersAsync()
            : Task.CompletedTask;
    }

    private void HandleSourceExclusionKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !IsBusy)
        {
            ExcludeSource();
        }
    }

    private void HandleEventTypeExclusionKeyDown(
        KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && !IsBusy)
        {
            ExcludeEventTypeFromInput();
        }
    }

    private static string? NormalizeExclusion(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private static string FormatTimestamp(
        DateTimeOffset timestamp)
    {
        return timestamp
            .ToLocalTime()
            .ToString("yyyy-MM-dd HH:mm:ss zzz");
    }

    private static string FormatRelativeTimestamp(
        DateTimeOffset timestamp)
    {
        TimeSpan age =DateTimeOffset.UtcNow - timestamp;

        if (age < TimeSpan.Zero)
        {
            age = TimeSpan.Zero;
        }

        if (age < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        if (age < TimeSpan.FromHours(1))
        {
            return FormatElapsed(
                (int)age.TotalMinutes,
                "minute");
        }

        if (age < TimeSpan.FromHours(24))
        {
            return FormatElapsed(
                (int)age.TotalHours,
                "hour");
        }

        return FormatTimestamp(timestamp);
    }

    private static string FormatElapsed(
        int value,
        string unit)
    {
        string suffix =
            value == 1
                ? string.Empty
                : "s";

        return $"{value} {unit}{suffix} ago";
    }

    private async Task RefreshRelativeTimestampsAsync(
        CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new(TimeSpan.FromMinutes(1));

        try
        {
            while (await timer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
    }
    private void OpenEventModal(Guid eventId)
    {
        _feed?.SelectEvent(eventId);
    }

    private void CloseEventModal()
    {
        _feed?.CloseSelectedEvent();
    }

    private Task HandleEventKeyDown(
        KeyboardEventArgs eventArgs,
        Guid eventId)
    {
        if (eventArgs.Key is "Enter" or " " or "Spacebar")
        {
            OpenEventModal(eventId);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        await _disposeSource.CancelAsync();

        if (_relativeTimeRefreshTask is not null)
        {
            await _relativeTimeRefreshTask;
        }

        _disposeSource.Dispose();
    }
}

@page "/services"

@implements IAsyncDisposable

@inject MobileHostFleetState HostFleetState
@inject MobileServiceCatalog Catalog

<PageTitle>Services</PageTitle>

@{
    ServiceCatalogView view =
        ServiceCatalogViewBuilder.BuildForNode(
            _services,
            _selectedNodeId,
            CurrentSnapshot,
            _filter);
}

<div class="mobile-services-page">
    <header class="mobile-page-header">
        <div class="page-eyebrow">
            Service operations
        </div>

        <h1>Services</h1>

        <p>
            Inspect applications, containers, protocols, and live
            probe results.
        </p>
    </header>

    <section class="service-node-selector">
        <div>
            <label for="mobile-service-node"
                   class="form-label">
                Host
            </label>

            <select id="mobile-service-node"
                    class="form-select"
                    disabled="@HostFleetState.IsInitialLoading"
                    @bind="_selectedNodeId">
                @foreach (HostNodeSnapshot host in HostFleetState.Hosts)
                {
                    <option value="@host.NodeId">
                        @host.DisplayName
                    </option>
                }
            </select>
        </div>

        <span>
            Container and protocol observations are matched
            against the selected host.
        </span>
    </section>

    <AgentSnapshotPanel Snapshot="CurrentSnapshot"
                        IsLoading="HostFleetState.IsInitialLoading"
                        IsRefreshing="HostFleetState.IsRefreshing"
                        IsManualRefreshing="HostFleetState.IsManualRefreshing"
                        ErrorMessage="@GetSnapshotError()"
                        TimestampFormatter="FormatTimestamp"
                        OnRefresh="RefreshSnapshotAsync" />

    @if (_catalogError is not null)
    {
        <div class="alert alert-danger">
            @_catalogError
        </div>
    }

    <ServiceSummaryCards ConfiguredServices="view.ConfiguredServices"
                         RunningContainers="view.RunningContainers"
                         PublicServices="view.PublicServices"
                         SnapshotContainers="view.SnapshotContainers"
                         SuccessfulProbes="view.SuccessfulProbes"
                         FailedProbes="view.FailedProbes" />

    <section class="service-toolbar">
        <div>
            <label for="mobile-service-filter"
                   class="form-label">
                Filter services
            </label>

            <input id="mobile-service-filter"
                   type="search"
                   class="form-control"
                   placeholder="Name, protocol, container..."
                   autocomplete="off"
                   @bind="_filter"
                   @bind:event="oninput" />
        </div>

        <div class="service-result-count">
            @view.MatchingServices.ToString("N0")
            matching services
        </div>
    </section>

    <UncataloguedContainersPanel Containers="view.UncataloguedContainers" />

    <UncataloguedProtocolsPanel Protocols="view.UncataloguedProtocols" />

    @if (!HostFleetState.IsInitialLoading &&
         view.Groups.Count == 0)
    {
        <div class="alert alert-info">
            No services matched that filter.
        </div>
    }
    else
    {
        @foreach (ServiceGroupView group in view.Groups)
        {
            <section class="service-group">
                <div class="service-group-heading">
                    <div>
                        <div class="page-eyebrow">
                            Service group
                        </div>

                        <h2>@group.Name</h2>
                    </div>

                    <span>
                        @group.Services.Count.ToString("N0")
                        services
                    </span>
                </div>

                <div class="service-list">
                    @foreach (ServiceItemView item in group.Services)
                    {
                        <ServiceEntry Service="item.Service"
                                      Container="item.Container"
                                      Protocol="item.Protocol"
                                      IsSnapshotAvailable="@(CurrentSnapshot is not null)"
                                      DockerAvailable="@CurrentSnapshot?.DockerAvailable" />
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly TimeSpan PollingInterval =
        TimeSpan.FromSeconds(30);

    private readonly CancellationTokenSource _disposeSource =
        new();

    private IReadOnlyList<ServiceDefinition> _services = [];
    private string? _filter;
    private string? _catalogError;
    private Task? _pollingTask;

    private string _selectedNodeId = "clanker"; // TODO

    private HostNodeSnapshot? CurrentHost =>
        HostFleetState.Hosts
            .FirstOrDefault(
                host => string.Equals(
                    host.NodeId,
                    _selectedNodeId,
                    StringComparison.OrdinalIgnoreCase));

    private PublicNodeSnapshot? CurrentSnapshot =>
        CurrentHost?.AgentSnapshot;

    protected override async Task OnInitializedAsync()
    {
        HostFleetState.Changed += HandleHostFleetStateChanged;

        try
        {
            _services = await Catalog.GetServicesAsync();
        }
        catch (Exception exception)
            when (exception is
                IOException or
                JsonException or
                InvalidOperationException)
        {
            _catalogError =
                "Could not load the service catalog: " +
                exception.Message;
        }

        await HostFleetState.EnsureLoadedAsync(_disposeSource.Token);
        EnsureSelectedNode();

        _pollingTask = HostFleetState.RunPollingAsync(PollingInterval, _disposeSource.Token);
    }

    private Task RefreshSnapshotAsync()
    {
        return HostFleetState.RefreshAsync(
            isManualRefresh: true,
            _disposeSource.Token);
    }

    private string? GetSnapshotError()
    {
        if (CurrentHost is not null)
        {
            return CurrentHost.AgentError;
        }

        if (!string.IsNullOrWhiteSpace(HostFleetState.ErrorMessage))
        {
            return HostFleetState.ErrorMessage;
        }

        return HostFleetState.IsInitialLoading
            ? null
            : $"{_selectedNodeId} is not available in host telemetry.";
    }

    private void HandleHostFleetStateChanged()
    {
        EnsureSelectedNode();

        _ = InvokeAsync(StateHasChanged);
    }

    private void EnsureSelectedNode()
    {
        if (HostFleetState.Hosts.Count == 0)
        {
            return;
        }

        bool selectedNodeExists = HostFleetState.Hosts.Any(
            host =>
                string.Equals(
                    host.NodeId,
                    _selectedNodeId,
                    StringComparison.OrdinalIgnoreCase));

        if (!selectedNodeExists)
        {
            _selectedNodeId = HostFleetState.Hosts[0].NodeId;
        }
    }

    private static string FormatTimestamp(
        DateTimeOffset timestamp)
    {
        return timestamp
            .ToLocalTime()
            .ToString(
                "yyyy-MM-dd HH:mm:ss zzz");
    }

    public async ValueTask DisposeAsync()
    {
        HostFleetState.Changed -=
            HandleHostFleetStateChanged;

        await _disposeSource.CancelAsync();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}
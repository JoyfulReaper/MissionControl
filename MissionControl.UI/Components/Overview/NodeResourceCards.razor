@if (IsLoading)
{
    <div class="resource-grid" aria-label="Loading node resource usage">
        @for (int index = 0; index < 3; index++)
        {
            <div class="resource-card resource-card-loading">
                <span></span>
                <strong></strong>
                <div></div>
            </div>
        }
    </div>
}
else if (Host is not null && HasResourceMetrics)
{
    <div class="resource-grid">
        @if (HasMemoryMetrics)
        {
            <article class="resource-card">
                <div class="resource-card-heading">
                    <h3>Memory</h3>
                    <strong>@($"{MemoryPercent:0.#}%")</strong>
                </div>

                <div class="resource-progress"
                     role="progressbar"
                     aria-label="Host memory usage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@($"{MemoryPercent:0.#}")">
                    <div class="resource-progress-value"
                         style="@GetProgressStyle(MemoryPercent)">
                    </div>
                </div>

                <div class="resource-card-meta">
                    <span>
                        @FormatBytes(MemoryUsedBytes) of
                        @FormatBytes(Host.MemoryTotalBytes!.Value) used
                    </span>
                    <span>
                        @FormatBytes(Host.MemoryAvailableBytes!.Value) available
                    </span>
                </div>
            </article>
        }

        @if (CpuPercent is not null)
        {
            <article class="resource-card">
                <div class="resource-card-heading">
                    <h3>CPU</h3>
                    <strong>@($"{CpuPercent.Value:0.#}%")</strong>
                </div>

                <div class="resource-progress"
                     role="progressbar"
                     aria-label="Host CPU usage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@($"{CpuPercent.Value:0.#}")">
                    <div class="resource-progress-value"
                         style="@GetProgressStyle(CpuPercent.Value)">
                    </div>
                </div>

                <div class="resource-card-meta resource-card-meta-end">
                    <span>
                        @Host.LogicalProcessorCount
                        @(Host.LogicalProcessorCount == 1
                            ? "logical CPU"
                            : "logical CPUs")
                    </span>
                </div>
            </article>
        }

        @if (HasLoadAverageMetrics)
        {
            <article class="resource-card">
                <div class="resource-card-heading">
                    <h3>Load average</h3>
                    <strong>
                        @Host.LogicalProcessorCount
                        @(Host.LogicalProcessorCount == 1 ? "CPU" : "CPUs")
                    </strong>
                </div>

                <div class="load-average-values"
                     aria-label="Host load averages">
                    <div>
                        <strong>@FormatLoadAverage(Host.LoadAverage1Minute)</strong>
                        <span>1 min</span>
                    </div>
                    <div>
                        <strong>@FormatLoadAverage(Host.LoadAverage5Minutes)</strong>
                        <span>5 min</span>
                    </div>
                    <div>
                        <strong>@FormatLoadAverage(Host.LoadAverage15Minutes)</strong>
                        <span>15 min</span>
                    </div>
                </div>
            </article>
        }
        @if (Host.Disks?.Count > 0 || !string.IsNullOrWhiteSpace(Host.DiskError))
        {
            <article class="resource-card disk-resource-card">
                <div class="resource-card-heading">
                    <h3>Disk usage</h3>
                </div>
                <div class="disk-mounts">
                    @foreach (PublicDiskUsage disk in Host.Disks ?? [])
                    {
                        <div class="disk-mount">
                            <div class="disk-mount-heading">
                                <strong title="@disk.MountPoint">@disk.MountPoint</strong>
                                <span>@($"{disk.UsagePercent:0.#}%")</span>
                            </div>
                            <div class="resource-progress" role="progressbar" aria-label="@($"Disk usage for {disk.MountPoint}")"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@($"{disk.UsagePercent:0.#}")">
                                <div class="resource-progress-value" style="@GetProgressStyle(disk.UsagePercent)"></div>
                            </div>
                            <div class="resource-card-meta">
                                <span>@FormatBytes(disk.UsedBytes) / @FormatBytes(disk.TotalBytes) used</span>
                                <span>@FormatBytes(disk.AvailableBytes) available</span>
                            </div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Host.DiskError))
                {
                    <p class="disk-error" role="status">Disk usage is unavailable for one or more filesystems.</p>
                }
            </article>
        }
    </div>
}
else if (Host is not null)
{
    <div class="alert alert-warning resource-alert">
        @(ErrorMessage ??
            NodeResourceCalculations.UnavailableMessage)
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-warning resource-alert">
        @ErrorMessage
    </div>
}

@code {
    [Parameter]
    public PublicHostMetric? Host { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private bool HasMemoryMetrics =>
        NodeResourceCalculations.HasMemoryMetrics(Host);

    private double? CpuPercent =>
        NodeResourceCalculations.GetCpuPercent(Host);

    private bool HasResourceMetrics =>
        NodeResourceCalculations.HasResourceMetrics(Host);

    private bool HasLoadAverageMetrics =>
        NodeResourceCalculations.HasLoadAverageMetrics(Host);

    private long MemoryUsedBytes =>
        NodeResourceCalculations.GetMemoryUsedBytes(Host);

    private double MemoryPercent =>
        NodeResourceCalculations.GetMemoryPercent(Host);

    private static string GetProgressStyle(double percentage)
    {
        double width = Math.Clamp(percentage, 0, 100);
        return $"width: {width:0.##}%";
    }

    private static string FormatBytes(long bytes)
    {
        return NodeResourceCalculations.FormatBytes(bytes);
    }

    private static string FormatLoadAverage(double? loadAverage)
    {
        return loadAverage?.ToString("0.00") ?? "--";
    }
}

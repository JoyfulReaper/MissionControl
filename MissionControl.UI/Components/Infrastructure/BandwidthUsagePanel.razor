@implements IAsyncDisposable
@inject IBandwidthUsageClient BandwidthClient

<section class="bandwidth-panel"
         aria-labelledby="bandwidth-title">
    <div class="bandwidth-heading">
        <div>
            <div class="bandwidth-eyebrow">
                GreenCloud VPS
            </div>

            <h2 id="bandwidth-title">
                Bandwidth usage
            </h2>
        </div>

        <button type="button"
                class="btn btn-sm btn-outline-primary"
                disabled="@(_isLoading || _isRefreshing)"
                @onclick="RefreshAsync">
            @(_isRefreshing
                ? "Refreshing..."
                : "Refresh")
        </button>
    </div>

    <BandwidthUsageCard Snapshot="_snapshot"
                        IsLoading="_isLoading"
                        ErrorMessage="@_error" />
</section>

@code {
    [Parameter]
    public int RefreshSeconds { get; set; } = 300;

    private readonly CancellationTokenSource _disposeSource = new();

    private BandwidthUsageSnapshot? _snapshot;
    private Task? _pollingTask;
    private string? _error;
    private bool _isLoading = true;
    private bool _isRefreshing;

    protected override async Task OnInitializedAsync()
    {
        CancellationToken cancellationToken =_disposeSource.Token;

        await LoadAsync(isManualRefresh: false,  cancellationToken);

        if (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        _pollingTask = PollAsync(cancellationToken);
    }

    private Task RefreshAsync()
    {
        return LoadAsync(isManualRefresh: true,  _disposeSource.Token);
    }

    private async Task LoadAsync(
        bool isManualRefresh,
        CancellationToken cancellationToken)
    {
        if (_isRefreshing)
        {
            return;
        }

        _isLoading = _snapshot is null;
        _isRefreshing = isManualRefresh;

        try
        {
            _snapshot = await BandwidthClient.GetAsync(cancellationToken);
            _error = null;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (HttpRequestException exception)
        {
            _error = exception.StatusCode ==
                System.Net.HttpStatusCode.Unauthorized
                    ? "GreenCloud rejected the API token."
                    : "GreenCloud could not be reached: " +
                      exception.Message;
        }
        catch (TaskCanceledException)
        {
            _error = "The GreenCloud request timed out.";
        }
        catch (Exception exception)
            when (exception is
                InvalidOperationException or
                System.Text.Json.JsonException)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private async Task PollAsync(
        CancellationToken cancellationToken)
    {
        using var timer =
            new PeriodicTimer(TimeSpan.FromSeconds(Math.Clamp(RefreshSeconds, 60, 3600)));

        try
        {
            while (await timer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await InvokeAsync(
                    async () =>
                    {
                        await LoadAsync(isManualRefresh: false, cancellationToken);

                        StateHasChanged();
                    });
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeSource.Cancel();

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _disposeSource.Dispose();
    }
}
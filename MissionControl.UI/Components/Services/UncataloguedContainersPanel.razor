@if (Containers.Count > 0)
{
    <section class="uncatalogued-panel"
             aria-label="Uncatalogued containers">
        <div class="uncatalogued-heading">
            <strong>Uncatalogued snapshot containers</strong>
            <span>
                Add these to services.json when they are expected.
            </span>
        </div>

        <div class="uncatalogued-list">
            @foreach (PublicContainerStatus container in Containers)
            {
                <div class="uncatalogued-item">
                    <strong>@container.Name</strong>
                    <span>@container.State</span>
                    <span>
                        Observed image:
                        @AgentDiagnosticPresentation.FormatOptional(
                            container.Image)
                    </span>
                    <span>
                        @ContainerResourcePresentation.FormatMemory(
                            container.MemoryUsageBytes,
                            container.MemoryLimitBytes,
                            container.MemoryPercent)
                    </span>
                    <span>
                        @(ContainerResourcePresentation.FormatCpu(
                            container.CpuPercent)) CPU
                    </span>
                    <span>
                        @(ContainerResourcePresentation.FormatRestartCount(
                            container.RestartCount)) restarts
                    </span>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<PublicContainerStatus> Containers
    {
        get;
        set;
    }
}

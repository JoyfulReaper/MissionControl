{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "NodeName": "joyful-vps",
    "DockerSocketPath": "/var/run/docker.sock",
    "IntervalSeconds": 60,
    "DockerTimeoutSeconds": 5,
    "Probes": [
      {
        "Name": "happyecho",
        "Host": "127.0.0.1",
        "Port": 7,
        "Protocol": "echo"
      },
      {
        "Name": "happyqotd",
        "Host": "127.0.0.1",
        "Port": 17,
        "Protocol": "qotd"
      },
      {
        "Name": "happygopher",
        "Host": "127.0.0.1",
        "Port": 70,
        "Protocol": "gopher"
      },
      {
        "Name": "happyfinger",
        "Host": "127.0.0.1",
        "Port": 79,
        "Protocol": "finger"
      }
    ]
  },
  "AgentApi": {
    "StaleAfterSeconds": 180,
    "AllowedOrigins": [
      "https://kgivler.com",
      "https://www.kgivler.com"
    ]
  },
  "AgentStorage": {
    "DatabaseFileName": "mission-control-agent.db",
    "BasePath": "Data"
  },
  "MissionControl": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:5190",
    "ApiKey": "",
    "TimeoutMilliseconds": 1000
  }
}
